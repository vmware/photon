diff --git a/kexmlkemevp.c b/kexmlkemevp.c
new file mode 100644
index 0000000..c6118aa
--- /dev/null
+++ b/kexmlkemevp.c
@@ -0,0 +1,212 @@
+/*
+ * Copyright (c) 2026 VMWare Inc
+ * (Derived from kexmlkem768x25519.c: Copyright (c) 2023 Markus Friedl.)
+ *
+ * Redistribution and use in source and binary forms, with or without

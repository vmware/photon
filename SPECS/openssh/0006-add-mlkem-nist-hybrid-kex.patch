 	char *cp = NULL, *cp2 = NULL;
+#if defined(WITH_OPENSSL) && defined(USE_MLKEM768X25519)
+	int mlkem768_available = is_mlkem768_available();
+	int mlkem1024_available = is_mlkem1024_available();
 
+	if ((ssh->compat & (SSH_BUG_CURVE25519PAD|SSH_OLD_DHGEX)) == 0 &&
+	    mlkem768_available && mlkem1024_available)
+		return xstrdup(p);
+#else
 	if ((ssh->compat & (SSH_BUG_CURVE25519PAD|SSH_OLD_DHGEX)) == 0)
 		return xstrdup(p);
+#endif
 	debug2_f("original KEX proposal: %s", p);
 	if ((ssh->compat & SSH_BUG_CURVE25519PAD) != 0)
 		if ((cp = match_filter_denylist(p,

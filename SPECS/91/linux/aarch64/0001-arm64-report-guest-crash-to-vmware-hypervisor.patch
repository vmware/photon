From 6cb0716fb1c4697ae54f2c92aeac9524f18bab34 Mon Sep 17 00:00:00 2001
From: Brennan Lamoreaux <brennan.lamoreaux@broadcom.com>
Date: Tue, 27 May 2025 17:07:01 +0000
Subject: [PATCH] arm64: report guest crash to vmware hypervisor

Register the guest crash reporter to panic_notifier_list,
which will be called at panic time. Guest crash reporter
will report the crash to the hypervisor through
a hypercall.

Signed-off-by: Brennan Lamoreaux <brennan.lamoreaux@broadcom.com>
---
 arch/arm64/kernel/vmware.c | 51 +++++++++++++++++++++++++++++++++++---
 1 file changed, 47 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/kernel/vmware.c b/arch/arm64/kernel/vmware.c
index 50391b495..4c19da231 100644
--- a/arch/arm64/kernel/vmware.c
+++ b/arch/arm64/kernel/vmware.c
@@ -13,6 +13,7 @@
 #include <linux/of.h>
 #include <linux/of_fdt.h>
 #include <linux/kmsg_dump.h>
+#include <linux/panic_notifier.h>

 #include <asm/hypervisor.h>
 #include <asm/vmware.h>
@@ -38,10 +39,12 @@
 	(VMWARE_CMD_MESSAGE | MESSAGE_TYPE_SEND)
 #define VMWARE_CMD_MSG_CLOSE \
 	(VMWARE_CMD_MESSAGE | MESSAGE_TYPE_CLOSE)
-#define VMWARE_CMD_GETHZ         45
-#define VMWARE_CMD_MESSAGE       30
-#define VMWARE_CMD_GETVERSION    10
-#define VMWARE_HB_CMD_MESSAGE    0
+
+#define VMWARE_CMD_GETHZ                45
+#define VMWARE_CMD_MESSAGE              30
+#define VMWARE_CMD_GETVERSION           10
+#define VMWARE_CMD_REPORTGUESTCRASH     102
+#define VMWARE_HB_CMD_MESSAGE           0

 #define RPCI_PROTOCOL_NUM       0x49435052 /* 'RPCI' */
 #define GUESTMSG_FLAG_COOKIE    0x80000000
@@ -52,6 +55,44 @@ struct vmw_msg {
 	uint32_t cookie_low;
 };

+static void vmware_cmd_report_guest_crash(void)
+{
+	register uint64_t w0 asm("w0") = VMWARE_HYPERVISOR_MAGIC;
+	register uint32_t w1 asm("w1") = 0;
+	register uint32_t w2 asm("w2") = VMWARE_CMD_REPORTGUESTCRASH;
+	register uint32_t w3 asm("w3") = VMWARE_HYPERVISOR_PORT;
+	register uint32_t w7 asm("w7") = X86_IO_W7_WITH |
+					 2 << X86_IO_W7_SIZE_SHIFT;
+
+	__asm__ __volatile__ ("hvc %[magic]" :
+				"+r" (w0),
+				"+r" (w1),
+				"+r" (w2),
+				"+r" (w3) :
+				"r"  (w7),
+				[magic] "i" (X86_IO_MAGIC) :
+				"memory");
+}
+
+static int vmware_report_guest_crash(struct notifier_block *self,
+				unsigned long action,
+				void *data)
+{
+	vmware_cmd_report_guest_crash();
+	return 0;
+}
+
+static struct notifier_block vmware_guest_crash_reporter = {
+	.notifier_call = vmware_report_guest_crash
+};
+
+static int __init register_guest_crash_reporter(void)
+{
+	atomic_notifier_chain_register(&panic_notifier_list,
+					&vmware_guest_crash_reporter);
+	return 0;
+}
+
 static bool vmware_log_open(struct vmw_msg *msg)
 {
 	register uint64_t x0 asm("x0") = VMWARE_HYPERVISOR_MAGIC;
@@ -232,6 +273,8 @@ static struct kmsg_dumper kmsg_dumper = {
 static void __init vmware_platform_setup(void)
 {
 	kmsg_dump_register(&kmsg_dumper);
+
+	register_guest_crash_reporter();
 }

 static int __init fdt_find_hyper_node(unsigned long node,
--
2.40.4


diff --git a/arch/x86/hyperv/hv_init.c b/arch/x86/hyperv/hv_init.c
index 95eada299..086c9b83f 100644
--- a/arch/x86/hyperv/hv_init.c
+++ b/arch/x86/hyperv/hv_init.c
@@ -460,7 +460,7 @@ void __init hyperv_init(void)
 	union hv_x64_msr_hypercall_contents hypercall_msr;
 	int cpuhp;
 
-	if (x86_hyper_type != X86_HYPER_MS_HYPERV)
+	if (hyper_type != HYPER_MS_HYPERV)
 		return;
 
 	if (hv_common_init())
@@ -714,7 +714,7 @@ bool hv_is_hyperv_initialized(void)
 	 * Ensure that we're really on Hyper-V, and not a KVM or Xen
 	 * emulation of Hyper-V
 	 */
-	if (x86_hyper_type != X86_HYPER_MS_HYPERV)
+	if (hyper_type != HYPER_MS_HYPERV)
 		return false;
 
 	/* A TDX VM with no paravisor uses TDX GHCI call rather than hv_hypercall_pg */

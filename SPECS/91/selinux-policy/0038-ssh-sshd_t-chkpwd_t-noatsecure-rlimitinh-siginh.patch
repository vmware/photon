From 7b061cb9702dc0987b37bcc2020a83b2775907c7 Mon Sep 17 00:00:00 2001
From: Alexey Makhalov <alexey.makhalov@broadcom.com>
Date: Fri, 3 Apr 2026 00:01:19 +0000
Subject: [PATCH] ssh: allow sshd_t noatsecure/rlimitinh/siginh on chkpwd_t
 process transition

When sshd forks unix_chkpwd (transitioning sshd_t -> chkpwd_t via
execve), the kernel checks siginh/rlimitinh/noatsecure on the new
domain.  Without these rules the child starts with reset signal
dispositions and resource limits, and AT_SECURE=1 (glibc secure mode).
Authentication still works but three AVCs are logged on every SSH login:

  type=AVC msg=audit(...): avc: denied { siginh } for
    comm="unix_chkpwd"
    scontext=system_u:system_r:sshd_t:s0-s0:c0.c1023
    tcontext=system_u:system_r:chkpwd_t:s0-s0:c0.c1023
    tclass=process permissive=0

Made-with: Cursor
---
 policy/modules/services/ssh.te | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/policy/modules/services/ssh.te b/policy/modules/services/ssh.te
index f8dc3b8..7e46799 100644
--- a/policy/modules/services/ssh.te
+++ b/policy/modules/services/ssh.te
@@ -749,3 +749,13 @@ allow sshd_t var_log_t:file { create open read write };
 
 allow sshd_t var_log_t:file { create open read write };
 allow sshd_t var_log_t:file { setattr };
+
+# When sshd forks unix_chkpwd (transitioning sshd_t -> chkpwd_t via execve),
+# the kernel checks siginh/rlimitinh/noatsecure on the new domain.
+# Without these rules the child starts with reset signal dispositions and
+# resource limits, and AT_SECURE=1 (glibc secure mode).  Authentication
+# still works but three AVCs are logged on every SSH login attempt:
+#   avc: denied { siginh } for comm="unix_chkpwd"
+#     scontext=system_u:system_r:sshd_t tcontext=system_u:system_r:chkpwd_t
+#     tclass=process permissive=0
+allow sshd_t chkpwd_t:process { noatsecure rlimitinh siginh };
-- 

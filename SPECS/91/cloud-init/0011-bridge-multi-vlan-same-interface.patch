-        return ret_dict
 
     def render_bonds(self, ns: NetworkState) -> dict:
         bond_link_info: Dict[str, Any] = {}
@@ -534,89 +572,116 @@ def render_bonds(self, ns: NetworkState) -> dict:
             # Optional bond parameters
             params = bond_cfg.get("parameters", {})
 

 setup.cfg                |   2 -
 src/tpm2_pytss/tsskey.py | 116 +++++++++++++++++++++++++++------------
 test/test_tsskey.py      |  40 ++++++++++----
 4 files changed, 112 insertions(+), 48 deletions(-)


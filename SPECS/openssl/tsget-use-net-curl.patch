+                ok(run(app(["openssl", "ts", "-verify",
+                            "-queryfile", "test.tsq",
+                            "-in", "test.envtsr",
+                            "-CAfile", "tsaca.pem",
+                            "-untrusted", "tsa_cert.pem"])),

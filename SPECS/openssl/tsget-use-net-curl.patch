+
+            subtest "TSGET environment variable" => sub {
+                plan tests => 3;
+                local $ENV{TSGET} = "-v -e .envtsr -h $url";
+                ok(run(perlapp(["tsget.pl", "test.tsq"])),
+                   "tsget uses TSGET environment variable");

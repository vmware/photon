+                                "-queryfile", "subdir/test.tsq",
+                                "-in", "subdir/test.tsr",
+                                "-CAfile", "tsaca.pem",
+                                "-untrusted", "tsa_cert.pem"])),
+                        "timestamp reply is cryptographically valid");

+    pkgname = utils.config["mulversion_pkgname"]
+    utils.erase_package(pkgname)
+    pkgname_missing = "tdnf-missing-dep"
+
+    utils.run(['tdnf', 'install', '-y', '--nogpgcheck', '--skip-broken', pkgname, pkgname_missing])

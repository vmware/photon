From bdc00bb9280f30c21c7ae5f4f838bcd9dd6be0f9 Mon Sep 17 00:00:00 2001
From: Shreenidhi Shedi <shreenidhi.shedi@broadcom.com>
Date: Wed, 26 Aug 2026 12:56:19 +0530
Subject: [PATCH 1/4] ci: fix docker-entrypoint.sh to fail on build errors

Add set -e so build failures abort the script immediately.
Use nproc for dynamic parallel jobs instead of hardcoded 32.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Signed-off-by: Shreenidhi Shedi <shreenidhi.shedi@broadcom.com>
---
 ci/docker-entrypoint.sh | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/ci/docker-entrypoint.sh b/ci/docker-entrypoint.sh
index a5ba2376..6233e440 100755
--- a/ci/docker-entrypoint.sh
+++ b/ci/docker-entrypoint.sh
@@ -1,10 +1,13 @@
 #!/bin/bash
 
-rm -rf build
+set -e
+
+test -d build && rm -rf build
 mkdir -p build
 cd build || exit 1
 
-cmake .. && make -j32 && make python -j32 && make check -j32
+jobs=$(nproc)
+cmake .. && make -j${jobs} && make python -j${jobs} && make check -j${jobs}
 
 if ! flake8 ../pytests ; then
   echo "flake8 tests failed"


%global build_if %{BUILD_FOR}
%global security_hardening  none
%define src_ver             %{PKG_VERSION}
%define kernel_ver          %{KERNEL_VERSION}-%{KERNEL_RELEASE}
%define uname_r             %{kernel_ver}%{KERNEL_FLAVOUR}
%define kern_pkg_name       linux%{KERNEL_FLAVOUR}
%define _modulesdir         /lib/modules/%{uname_r}
%define conflicts_ver       6.1.70-2%{?dist}

Summary:        Intel ice driver v%{PKG_VERSION}
Name:           linux%{KERNEL_FLAVOUR}-drivers-intel-ice
Version:        %{PKG_VERSION}
URL:            https://sourceforge.net/projects/e1000
Group:          System Environment/Kernel
Vendor:         VMware, Inc.
Distribution:   Photon

Source0: https://sourceforge.net/projects/e1000/files/ice%20stable/%{src_ver}/ice-%{src_ver}.tar.gz

%if "%{src_ver}" == "2.3.10"
Release:        1%{?kernelsubrelease}%{?dist}
%endif

%if "%{src_ver}" == "1.14.9"
Release:        7%{?kernelsubrelease}%{?dist}
%endif

%if "%{src_ver}" == "1.13.7"
Release:        9%{?kernelsubrelease}%{?dist}
%endif

Source1: spec_install_post.inc

Source2: license_ice.txt
%include %{SOURCE2}

BuildArch:      x86_64

BuildRequires:  which
BuildRequires:  kmod-devel
BuildRequires:  util-linux
BuildRequires:  %{kern_pkg_name}-devel = %{kernel_ver}
%if "%{?signing_script}" != ""
%define network_required 1
BuildRequires:  ca-certificates-pki
BuildRequires:  python3-requests
%endif

Requires:       kmod
Requires:       %{kern_pkg_name} = %{kernel_ver}

Conflicts:      %{kern_pkg_name} < %{conflicts_ver}

%description
This Linux package contains the Intel ice v%{src_ver} driver.

%package docs
Summary:        Kernel docs
Group:          System Environment/Kernel

Conflicts:      %{kern_pkg_name}-docs < %{conflicts_ver}

%description docs
This Linux package contains the Linux kernel doc files including files that
were left unpackaged from %{kern_pkg_name} in the %{_mandir}.

%prep
%if "%{src_ver}" == "2.3.10"
%autosetup -p1 -n ethernet-linux-ice-%{src_ver}
%else
%autosetup -p1 -n ice-%{src_ver}
%endif

%build
make -C src KSRC=%{_modulesdir}/build %{?_smp_mflags}

%install
make -C src KSRC=%{_modulesdir}/build INSTALL_MOD_PATH=%{buildroot} \
    INSTALL_MOD_DIR=extra/ice-%{src_ver} MANDIR=%{_mandir} \
    modules_install mandocs_install %{?_smp_mflags}

find %{buildroot}%{_modulesdir} -name *.ko -type f -print0 | xargs -0 chmod u+x
%include %{SOURCE1}

%post
/sbin/depmod -a %{uname_r}

%files
%defattr(-,root,root)
%dir %{_modulesdir}/extra/ice-%{src_ver}
%{_modulesdir}/extra/ice-%{src_ver}/ice.ko.xz
# ICE driver firmware files are packaged in linux-firmware
%exclude /lib/firmware/updates/intel/ice

%files docs
%defattr(-,root,root)
%{_mandir}/*

%changelog
%if "%{src_ver}" == "2.3.10"
* Wed Oct 08 2025 Ajay Kaher <ajay.kaher@broadcom.com> %{PKG_VERSION}-1
- Initial addition of ice v2.3.10
%endif

%if "%{src_ver}" == "1.14.9"
* Thu Jan 15 2025 Ankit Jain <ankit-aj.jain@broadcom.com> %{PKG_VERSION}-7
- Release bump
* Thu Oct 23 2025 Ajay Kaher <ajay.kaher@broadcom.com> %{PKG_VERSION}-6
- Release bump
* Mon Jun 30 2025 Ankit Jain <ankit-aj.jain@broadcom.com> %{PKG_VERSION}-5
- Adding signing to the module
* Thu Mar 20 2025 Ankit Jain <ankit-aj.jain@broadcom.com> %{PKG_VERSION}-4
- Bump-up to build with kmod-34.1
* Wed Jan 08 2025 Mukul Sikka <mukul.sikka@broadcom.com> %{PKG_VERSION}-3
- Release bump for SRP compliance
* Wed Jun 05 2024 Ankit Jain <ankit-ja.jain@broadcom.com> %{PKG_VERSION}-2
- Package debug info in seperate pkg
* Tue May 14 2024 Brennan Lamoreaux <brennan.lamoreaux@broadcom.com> %{PKG_VERSION}-1
- Initial addition of ice v1.14.9
%endif

%if "%{src_ver}" != "1.14.9"
* Thu Jan 15 2025 Ankit Jain <ankit-aj.jain@broadcom.com> %{PKG_VERSION}-9
- Release bump
* Thu Oct 23 2025 Ajay Kaher <ajay.kaher@broadcom.com> %{PKG_VERSION}-8
- Release bump
* Mon Jun 30 2025 Ankit Jain <ankit-aj.jain@broadcom.com> %{PKG_VERSION}-7
- Adding signing to the module
* Thu Mar 20 2025 Ankit Jain <ankit-aj.jain@broadcom.com> %{PKG_VERSION}-6
- Bump-up to build with kmod-34.1
* Wed Jan 08 2025 Mukul Sikka <mukul.sikka@broadcom.com> %{PKG_VERSION}-5
- Release bump for SRP compliance
* Wed Jun 05 2024 Ankit Jain <ankit-ja.jain@broadcom.com> %{PKG_VERSION}-4
- Package debug info in seperate pkg
* Tue Apr 02 2024 Ankit Jain <ankit-ja.jain@broadcom.com> %{PKG_VERSION}-3
- Fix subrelease naming convention
* Wed Jan 31 2024 Ankit Jain <ankit-ja.jain@broadcom.com> %{PKG_VERSION}-2
- Adding generic template for ice driver
* Wed Jan 31 2024 Brennan Lamoreaux <brennan.lamroeaux@broadcom.com> %{PKG_VERSION}-1
- Add new ice v%{PKG_VERSION} driver
%endif

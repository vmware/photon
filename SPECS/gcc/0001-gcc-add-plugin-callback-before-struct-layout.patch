From 3994a70c88c56830592d8ba6fe29ac07e47359d0 Mon Sep 17 00:00:00 2001
From: Brennan Lamoreaux <brennan.lamoreaux@broadcom.com>
Date: Tue, 25 Mar 2025 23:03:56 +0000
Subject: [PATCH] gcc: add plugin callback before struct layout

---
 gcc/c/c-decl.cc | 3 +++
 gcc/plugin.cc   | 4 +++-
 gcc/plugin.def  | 3 +++
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/gcc/c/c-decl.cc b/gcc/c/c-decl.cc
index c701f07be..38e4d12d7 100644
--- a/gcc/c/c-decl.cc
+++ b/gcc/c/c-decl.cc
@@ -8838,6 +8838,9 @@ finish_struct (location_t loc, tree t, tree fieldlist, tree attributes,

   TYPE_FIELDS (t) = fieldlist;

+  invoke_plugin_callbacks (PLUGIN_BEFORE_STRUCT_LAYOUT, t);
+  fieldlist = TYPE_FIELDS(t);
+
   maybe_apply_pragma_scalar_storage_order (t);

   layout_type (t);
diff --git a/gcc/plugin.cc b/gcc/plugin.cc
index da4dec5b4..1f8530174 100644
--- a/gcc/plugin.cc
+++ b/gcc/plugin.cc
@@ -499,6 +499,7 @@ register_callback (const char *plugin_name,
       case PLUGIN_INCLUDE_FILE:
       case PLUGIN_ANALYZER_INIT:
       case PLUGIN_TYPE_CAST:
+      case PLUGIN_BEFORE_STRUCT_LAYOUT:
         {
           struct callback_info *new_callback;
           if (!callback)
@@ -581,6 +582,7 @@ invoke_plugin_callbacks_full (int event, void *gcc_data)
       case PLUGIN_INCLUDE_FILE:
       case PLUGIN_ANALYZER_INIT:
       case PLUGIN_TYPE_CAST:
+      case PLUGIN_BEFORE_STRUCT_LAYOUT:
         {
           /* Iterate over every callback registered with this event and
              call it.  */
diff --git a/gcc/plugin.def b/gcc/plugin.def
index 2fa6b3548..09b9ef774 100644
--- a/gcc/plugin.def
+++ b/gcc/plugin.def
@@ -29,6 +29,9 @@ DEFEVENT (PLUGIN_PASS_MANAGER_SETUP)
 /* After finishing parsing a type.  */
 DEFEVENT (PLUGIN_FINISH_TYPE)

+/* Before finalizing struct */
+DEFEVENT (PLUGIN_BEFORE_STRUCT_LAYOUT)
+
 /* After finishing parsing a declaration. */
 DEFEVENT (PLUGIN_FINISH_DECL)

--
2.39.4


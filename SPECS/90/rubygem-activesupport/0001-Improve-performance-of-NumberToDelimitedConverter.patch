From 42ec7f972b56a628b13378aff81e3e641e4cef8c Mon Sep 17 00:00:00 2001
From: Jean Boussier <jean.boussier@gmail.com>
Date: Wed, 4 Mar 2026 10:33:46 +0100
Subject: [PATCH] Improve performance of NumberToDelimitedConverter

[CVE-2026-33169]
[GHSA-cg4j-q9v8-6v38]

[Shivani: Removed test file changes]
Signed-off-by: Shivani Agarwal <shivani.agarwal@broadcom.com>
---
 .../number_to_delimited_converter.rb          | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/lib/active_support/number_helper/number_to_delimited_converter.rb b/lib/active_support/number_helper/number_to_delimited_converter.rb
index 4fb2fb7..7575429 100644
--- a/lib/active_support/number_helper/number_to_delimited_converter.rb
+++ b/lib/active_support/number_helper/number_to_delimited_converter.rb
@@ -16,9 +16,24 @@ module ActiveSupport
       private
         def parts
           left, right = number.to_s.split(".")
-          left.gsub!(delimiter_pattern) do |digit_to_delimit|
-            "#{digit_to_delimit}#{options[:delimiter]}"
+          if delimiter_pattern
+            left.gsub!(delimiter_pattern) do |digit_to_delimit|
+              "#{digit_to_delimit}#{options[:delimiter]}"
+            end
+          else
+            left_parts = []
+            offset = left.size % 3
+            if offset > 0
+              left_parts << left[0, offset]
+            end
+
+            (left.size / 3).times do |i|
+              left_parts << left[offset + (i * 3), 3]
+            end
+
+            left = left_parts.join(options[:delimiter])
           end
+
           [left, right].compact
         end
 

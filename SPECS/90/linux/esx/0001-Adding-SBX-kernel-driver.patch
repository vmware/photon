+static int sbx_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	struct device *dev = &pdev->dev;
+	dev_t devno_sbx;
+	dev_t devno_sbx_mgr;
+	resource_size_t cmd_addr;
+	resource_size_t cmd_len;
+	int result;
+
+	if (sbx_device) {
+		dev_err(dev, "sbx: unexpected probe\n");
+		return -EPERM;
+	}
+
+	result = sbx_alloc_chrdev(dev, &devno_sbx);
+	if (result != 0)
+		return result;
+
+	result = sbx_mgr_alloc_chrdev(dev, &devno_sbx_mgr);
+	if (result != 0)
+		goto fail_chrdev;
+
+	result = sbx_alloc_device();
+	if (result != 0)
+		goto fail_mgr_chrdev;
+
+	result = sbx_init_pci(pdev, &cmd_addr, &cmd_len);
+	if (result != 0)
+		goto fail_device_struct;
+
+	result = sbx_init_hw(pdev, cmd_addr, cmd_len);
+	if (result != 0)
+		goto fail_pci;
+
+	result = sbx_create_class(dev);
+	if (result != 0)
+		goto fail_hw;
+
+	result = sbx_create_devices(dev);
+	if (result != 0)
+		goto fail_class;
+
+	result = sbx_mgr_create_devices(dev);
+	if (result != 0)
+		goto fail_devices;
+
+	result = sbx_add_cdev(dev, devno_sbx);
+	if (result != 0)
+		goto fail_mgr_devices;
+
+	result = sbx_mgr_add_cdev(dev, devno_sbx_mgr);
+	if (result != 0)
+		goto fail_cdev;
+
+	return 0;
+
+fail_cdev:
+	sbx_del_cdev();
+
+fail_mgr_devices:
+	sbx_mgr_destroy_devices();
+
+fail_devices:
+	sbx_destroy_devices();
+
+fail_class:
+	sbx_destroy_class();
+
+fail_hw:
+	sbx_cleanup_hw();
+
+fail_pci:
+	sbx_cleanup_pci(pdev);
+
+fail_device_struct:
+	kfree(sbx_device);
+	sbx_device = NULL;
+
+fail_mgr_chrdev:
+	sbx_mgr_free_chrdev();
+
+fail_chrdev:
+	sbx_free_chrdev();
+	dev_info(dev, "sbx probe: fail\n");
+
+	return result;
+}
+
+static void sbx_remove(struct pci_dev *pdev)
+{
+	struct device *dev = &pdev->dev;
+
+	if (sbx_device) {
+		sbx_mgr_del_cdev();
+
+		mutex_lock(&sbx_device->sbx_mgr_lock);
+		sbx_mgr_unpin_stats_file();
+		mutex_unlock(&sbx_device->sbx_mgr_lock);
+
+		sbx_del_cdev();
+		sbx_mgr_destroy_devices();
+		sbx_destroy_devices();
+		sbx_destroy_class();
+		sbx_cleanup_hw();
+		sbx_cleanup_pci(pdev);
+		kfree(sbx_device);
+		sbx_device = NULL;
+		sbx_mgr_free_chrdev();
+		sbx_free_chrdev();
+
+		pci_clear_master(pdev);
+	}
+
+	dev_info(dev, "sbx remove: major %d\n", sbx_mgr_major);
+	sbx_mgr_major = 0;
+
+	dev_info(dev, "sbx remove: major %d with minors %d-%d\n", sbx_major,
+		 SBX_MINOR_FIRST, SBX_MINOR_COUNT - 1);
+	sbx_major = 0;
+}
+
+static struct pci_device_id sbx_ids[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_VMWARE, 0x420), },
+	{ 0, }
+};
+
+static struct pci_driver sbx_driver = {
+	.name     = SBX_NAME,
+	.probe    = sbx_probe,
+	.remove   = sbx_remove,
+	.id_table = sbx_ids,
+};
+
+MODULE_DEVICE_TABLE(pci, sbx_ids);
+
+static int __init sbx_init_module(void)
+{
+	int ret = pci_register_driver(&sbx_driver);
+
+	if (ret < 0) {
+		pr_err("sbx init module: pci_register_driver fail\n");
+		return ret;
+	}
+
+	if (!sbx_device) {
+		pr_err("sbx init module: sbx_probe fail\n");
+		pci_unregister_driver(&sbx_driver);
+		return -ENODEV;
+	}
+
+	pr_info("sbx init module: success\n");
+	return 0;
+}
+
+static void __exit sbx_exit_module(void)
+{
+	pci_unregister_driver(&sbx_driver);
+	pr_info("sbx exit module: executed\n");
+}
+
+module_init(sbx_init_module);
+module_exit(sbx_exit_module);

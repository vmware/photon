+static int sbx_mgr_alloc_chrdev(struct device *dev, dev_t *devno_sbx_mgr)
+{
+	int result;
+
+	result = alloc_chrdev_region(devno_sbx_mgr, SBX_MGR_MINOR_FIRST,
+				     SBX_MGR_MINOR_COUNT, SBX_MGR_NAME);
+	if (result != 0) {
+		dev_err(dev, "sbx probe: alloc major number fail error=%d\n",
+			result);
+		return result;
+	}
+
+	sbx_mgr_major = MAJOR(*devno_sbx_mgr);
+	dev_info(dev, "sbx probe: alloc major number %d success\n",
+		 sbx_mgr_major);
+	return 0;
+}
+
+static void sbx_mgr_free_chrdev(void)
+{
+	unregister_chrdev_region(MKDEV(sbx_mgr_major, SBX_MGR_MINOR_FIRST),
+				 SBX_MGR_MINOR_COUNT);
+}
+
+static int sbx_alloc_device(void)
+{
+	unsigned int i;
+
+	sbx_device = kzalloc(sizeof(*sbx_device), GFP_KERNEL);
+	if (!sbx_device)
+		return -ENOMEM;
+
+	for (i = 0; i < SBX_MINOR_COUNT; i++)
+		mutex_init(&sbx_device->minor_device[i].lock);
+	mutex_init(&sbx_device->sbx_mgr_lock);
+	return 0;
+}

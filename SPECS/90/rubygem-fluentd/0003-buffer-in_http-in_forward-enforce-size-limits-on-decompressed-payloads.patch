--- a/lib/fluent/plugin/compressable.rb
+++ b/lib/fluent/plugin/compressable.rb
@@ -16,10 +16,63 @@
 
 require 'stringio'
 require 'zlib'
+require 'fluent/error'
 
 module Fluent
   module Plugin
     module Compressable
+      DEFAULT_DECOMPRESSION_SIZE_LIMIT = 256 * 1024 * 1024
+      BYTES_TO_READ = 64 * 1024
+      INFLATE_BYTES_TO_READ = 1024
+
+      class SizeLimitError < Fluent::UnrecoverableError; end
+
+      # Decompress concatenated gzip members, raising SizeLimitError when the
+      # decompressed data exceeds `limit` bytes.
+      def self.decompress_gzip(compressed_data, limit: DEFAULT_DECOMPRESSION_SIZE_LIMIT)
+        io = StringIO.new(compressed_data)
+        out = ''
+        loop do
+          reader = Zlib::GzipReader.new(io)
+          while (chunk = reader.read(BYTES_TO_READ))
+            out << chunk
+            if out.bytesize > limit
+              raise SizeLimitError, "Decompressed data exceeds limit of #{limit} bytes"
+            end
+          end
+
+          unused = reader.unused
+          reader.finish
+          unless unused.nil?
+            adjust = unused.length
+            io.pos -= adjust
+          end
+          break if io.eof?
+        end
+        out
+      end
+
+      def self.decompress_deflate(compressed_data, limit: DEFAULT_DECOMPRESSION_SIZE_LIMIT)
+        io = StringIO.new(compressed_data)
+        out = ''
+        begin
+          zstream = Zlib::Inflate.new
+          while (chunk = io.read(INFLATE_BYTES_TO_READ))
+            out << zstream.inflate(chunk)
+            if out.bytesize > limit
+              raise SizeLimitError, "Decompressed data exceeds limit of #{limit} bytes"
+            end
+          end
+          out << zstream.finish
+          if out.bytesize > limit
+            raise SizeLimitError, "Decompressed data exceeds limit of #{limit} bytes"
+          end
+        ensure
+          zstream&.close
+        end
+        out
+      end
+
       def compress(data, **kwargs)
         output_io = kwargs[:output_io]
         io = output_io || StringIO.new
@@ -55,30 +108,15 @@ module Fluent
       private
 
       def string_decompress(compressed_data)
-        io = StringIO.new(compressed_data)
-
-        out = ''
-        loop do
-          gz = Zlib::GzipReader.new(io)
-          out << gz.read
-          unused = gz.unused
-          gz.finish
-
-          unless unused.nil?
-            adjust = unused.length
-            io.pos -= adjust
-          end
-          break if io.eof?
-        end
-
-        out
+        Compressable.decompress_gzip(compressed_data, limit: @decompression_size_limit || DEFAULT_DECOMPRESSION_SIZE_LIMIT)
       end
 
       def io_decompress(input, output)
         loop do
           gz = Zlib::GzipReader.new(input)
-          v = gz.read
-          output.write(v)
+          while (v = gz.read(BYTES_TO_READ))
+            output.write(v)
+          end
           unused = gz.unused
           gz.finish
 

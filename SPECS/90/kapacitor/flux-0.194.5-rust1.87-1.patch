From 68c831c40b396f0274f6a9f97d77707c39970b02 Mon Sep 17 00:00:00 2001
From: Martin Hilton <mhilton@influxdata.com>
Date: Fri, 24 May 2024 16:57:10 +0100
Subject: [PATCH] fix(libflux): build on rust 1.78 (#5484)

* fix(libflux): build on rust 1.78

Fix compiler errors and clippy lints produced when attempting to
build using rust 1.78.

* fix: make generate
---
 libflux/flux-core/Cargo.toml                  |  1 +
 .../src/semantic/flatbuffers/types.rs         |  6 ++---
 libflux/flux-core/src/semantic/nodes.rs       |  4 ++--
 libflux/flux-core/src/semantic/sub.rs         | 24 +++++++++----------
 libflux/flux-core/src/semantic/types.rs       | 10 ++++----
 libflux/flux-core/src/semantic/walk/mod.rs    |  1 +
 libflux/flux/Cargo.toml                       |  1 +
 libflux/flux/src/cffi.rs                      |  2 +-
 libflux/go/libflux/buildinfo.gen.go           | 16 ++++++-------
 9 files changed, 35 insertions(+), 30 deletions(-)

diff --git a/libflux/flux-core/Cargo.toml b/libflux/flux-core/Cargo.toml
index f2f2c6674c..2de58f8fde 100644
--- a/libflux/flux-core/Cargo.toml
+++ b/libflux/flux-core/Cargo.toml
@@ -1,6 +1,7 @@
 [package]
 name = "flux-core"
 version = "0.154.0"
+rust-version = "1.68"
 authors = ["Flux Team <flux-developers@influxdata.com>"]
 edition = "2021"
 

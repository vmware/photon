diff --git a/Makefile b/Makefile
index 102da0c5..050eea44 100644
--- a/Makefile
+++ b/Makefile
@@ -1,6 +1,6 @@
 BASE_DIR         = $(shell pwd)
 ERLANG_BIN       = $(shell dirname $(shell which erl))
-GIT_VERSION      = $(shell git describe --tags --always)
+GIT_VERSION      = 2.1.0
 OVERLAY_VARS    ?=
 REBAR ?= $(BASE_DIR)/rebar3


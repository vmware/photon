From 0117063382a496588b9af76e4baa09cb1f06cbc6 Mon Sep 17 00:00:00 2001
From: Shreenidhi Shedi <shreenidhi.shedi@broadcom.com>
Date: Sun, 10 May 2026 22:19:33 +0530
Subject: [PATCH 7/8] uthash.cmake: use user provided source archive

Signed-off-by: Shreenidhi Shedi <shreenidhi.shedi@broadcom.com>
---
 cmake/modules/uthash.cmake | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/cmake/modules/uthash.cmake b/cmake/modules/uthash.cmake
index 4bdff114..b74932e3 100644
--- a/cmake/modules/uthash.cmake
+++ b/cmake/modules/uthash.cmake
@@ -13,8 +13,17 @@
 # the License.
 #
 
+set(UTHASH_DOWNLOAD_URL
+  "https://raw.githubusercontent.com/troydhanson/uthash/v1.9.8/src/uthash.h"
+  CACHE STRING "uthash header URL or local path"
+)
+
+set(UTHASH_ARCHIVE_URL
+  "https://github.com/troydhanson/uthash/archive/refs/tags/v1.9.8.tar.gz"
+  CACHE STRING "uthash archive URL or local path"
+)
+
 option(USE_BUNDLED_UTHASH "Enable downloading of the bundled uthash library" ${USE_BUNDLED_DEPS})
-set(UTHASH_DOWNLOAD_URL "https://raw.githubusercontent.com/troydhanson/uthash/v1.9.8/src/uthash.h")
 set(UTHASH_DOWNLOAD_DIR "${LIBS_DIR}/userspace/libscap")
 
 if(UTHASH_INCLUDE)
@@ -35,8 +44,7 @@ else()
 	ExternalProject_Add(
 		uthash
 		PREFIX "${PROJECT_BINARY_DIR}/uthash-prefix"
-		URL "https://github.com/troydhanson/uthash/archive/refs/tags/v1.9.8.tar.gz"
-		URL_HASH "SHA256=d9d123ce81c5d127442876fc3b12fab3ad632bee6aca685be7d461c08e24c046"
+		URL "${UTHASH_ARCHIVE_URL}"
 		CONFIGURE_COMMAND ""
 		BUILD_COMMAND ""
 		INSTALL_COMMAND ""
-- 

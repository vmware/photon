From 5f3148e068e1208dfd9831461c09d3741f953c04 Mon Sep 17 00:00:00 2001
From: Shreenidhi Shedi <shreenidhi.shedi@broadcom.com>
Date: Sat, 21 Mar 2026 17:22:36 +0530
Subject: [PATCH] Use mkpasswd to generate password hash

crypt module is obsolete, https://docs.python.org/3/library/crypt.html

Signed-off-by: Shreenidhi Shedi <shreenidhi.shedi@broadcom.com>
---
 photon_installer/commandutils.py | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/photon_installer/commandutils.py b/photon_installer/commandutils.py
index ab30e74..0e546f9 100644
--- a/photon_installer/commandutils.py
+++ b/photon_installer/commandutils.py
@@ -7,7 +7,6 @@ import subprocess
 import os
 import re
 import glob
-import crypt
 import shutil
 import ssl
 import requests
@@ -73,8 +72,13 @@ class CommandUtils(object):
 
     @staticmethod
     def generate_password_hash(password):
-        """Generate hash for the password"""
-        return crypt.crypt(password)
+        result = subprocess.run(
+            ["mkpasswd", "-m", "sha-512", password],
+            capture_output=True,
+            text=True,
+            check=True
+        )
+        return result.stdout.strip()
 
     @staticmethod
     def _requests_get(url, verify):

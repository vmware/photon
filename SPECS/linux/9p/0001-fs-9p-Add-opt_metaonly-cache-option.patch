From b3766db803ff096fdf5d102984f85a8356285e5d Mon Sep 17 00:00:00 2001
From: Ajay Kaher <akaher@vmware.com>
Date: Wed, 26 Aug 2020 17:03:24 +0530
Subject: [PATCH 1/8] fs, 9p: Add opt_metaonly cache option

Read/Write operation of 9p has two executions paths:

metadata: to bypass caching layer:
v9fs_cached_file_read_iter()->v9fs_file_read_iter()
v9fs_cached_file_write_iter()->v9fs_file_write_iter()

datapath: to involve generic caching read/write:
v9fs_cached_file_read_iter()->generic_file_read_iter()
v9fs_cached_file_write_iter()->generic_file_write_iter()

opt_metaonly helps to choose metadata read/write execution
path which bypass caching layer.

By-default opt_metaonly will be unset.

Example: cache=loose, metaonly

Signed-off-by: Ajay Kaher <akaher@vmware.com>
---
 Documentation/filesystems/9p.rst |  1 +
 fs/9p/v9fs.c                     | 10 ++++++++++
 fs/9p/v9fs.h                     |  1 +
 3 files changed, 12 insertions(+)

diff --git a/Documentation/filesystems/9p.rst b/Documentation/filesystems/9p.rst
index 523e036da..15554e010 100644
--- a/Documentation/filesystems/9p.rst
+++ b/Documentation/filesystems/9p.rst
@@ -238,6 +238,7 @@ Options
   cachetag	cache tag to use the specified persistent cache.
 		cache tags for existing cache sessions can be listed at
 		/sys/fs/9p/caches. (applies only to cache=fscache)
+  metaonly      to bypass caching layer, if cache is loose or mmap
 
   local_lock	Use only local posix locking from the perspective of "this"
 		kernel. Do not perform server side locking.
diff --git a/fs/9p/v9fs.c b/fs/9p/v9fs.c
index 099cb6719..2277b987c 100644
--- a/fs/9p/v9fs.c
+++ b/fs/9p/v9fs.c
@@ -41,6 +41,8 @@ enum {
 	Opt_nodevmap, Opt_noxattr, Opt_directio, Opt_ignoreqv,
 	/* Access options */
 	Opt_access, Opt_posixacl,
+	/* Metadata option: to bypass caching layer */
+	Opt_metaonly,
 	/* Lock timeout option */
 	Opt_locktimeout,
 	/* Local lock */
@@ -66,6 +68,7 @@ static const match_table_t tokens = {
 	{Opt_posixacl, "posixacl"},
 	{Opt_locktimeout, "locktimeout=%u"},
 	{Opt_local_lock, "local_lock"},
+	{Opt_metaonly, "metaonly"},
 	{Opt_err, NULL}
 };
 
@@ -152,6 +155,9 @@ int v9fs_show_options(struct seq_file *m, struct dentry *root)
 	if (v9ses->flags & V9FS_NO_XATTR)
 		seq_puts(m, ",noxattr");
 
+	if (v9ses->metaonly)
+		seq_puts(m, ",metaonly");
+
 	return p9_show_client_options(m, v9ses->clnt);
 }
 
@@ -372,6 +378,10 @@ static int v9fs_parse_options(struct v9fs_session_info *v9ses, char *opts)
 			v9ses->session_lock_timeout = (long)option * HZ;
 			break;
 
+		case Opt_metaonly:
+			v9ses->metaonly = true;
+			break;
+
 		case Opt_local_lock:
 			v9ses->flags |= V9FS_LOCAL_LOCK;
 			break;
diff --git a/fs/9p/v9fs.h b/fs/9p/v9fs.h
index 9dd33721d..48834f09f 100644
--- a/fs/9p/v9fs.h
+++ b/fs/9p/v9fs.h
@@ -114,6 +114,7 @@ struct v9fs_session_info {
 	unsigned short debug;
 	unsigned int afid;
 	unsigned int cache;
+	bool metaonly;
 #ifdef CONFIG_9P_FSCACHE
 	char *cachetag;
 	struct fscache_volume *fscache;
-- 

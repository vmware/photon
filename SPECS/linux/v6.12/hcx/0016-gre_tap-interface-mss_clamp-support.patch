From e726a9174a1804b54b1ce5679b0ba12e95fdb1ac Mon Sep 17 00:00:00 2001
From: Kevin Wang <wxianzhao@vmware.com>
Date: Sat, 25 Jun 2022 01:13:35 +0000
Subject: [PATCH 16/19] gre_tap interface mss_clamp support

Signed-off-by: Srish Srinivasan <ssrish@vmware.com>
---
 net/ipv4/ip_gre.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/net/ipv4/ip_gre.c b/net/ipv4/ip_gre.c
index 017206296736..8a75d9cf0a14 100644
--- a/net/ipv4/ip_gre.c
+++ b/net/ipv4/ip_gre.c
@@ -940,6 +940,12 @@ static netdev_tx_t gre_tap_xmit(struct sk_buff *skb,
 	if (skb_cow_head(skb, dev->needed_headroom))
 		goto free_skb;
 
+	if (gre_mss_clamp) {
+		if ((tunnel->parms.mss_clamp != 0) &&
+		    gre_tap_mss_clamp(skb, tunnel->parms.mss_clamp))
+			goto free_skb;
+	}
+
 	__gre_xmit(skb, dev, &tunnel->parms.iph, htons(ETH_P_TEB));
 	return NETDEV_TX_OK;
 

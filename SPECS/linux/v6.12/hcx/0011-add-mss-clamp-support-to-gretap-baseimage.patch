 include/uapi/linux/if_tunnel.h |   2 +
 net/ipv4/ip_gre.c              | 170 +++++++++++++++++++++++++++++++++
 net/ipv4/ip_tunnel.c           |   1 +
 4 files changed, 174 insertions(+)


---
 crypto/algapi.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/crypto/algapi.c b/crypto/algapi.c
index 004d27e41..3700c4c5d 100644
--- a/crypto/algapi.c
+++ b/crypto/algapi.c
@@ -20,6 +20,7 @@
 #include <linux/workqueue.h>
 
 #include "internal.h"
+#include "fips_canister_wrapper.h"
 
 static LIST_HEAD(crypto_template_list);
 
@@ -268,6 +269,7 @@ static struct crypto_larval *crypto_alloc_test_larval(struct crypto_alg *alg)
 
 	if (!IS_ENABLED(CONFIG_CRYPTO_MANAGER) ||
 	    IS_ENABLED(CONFIG_CRYPTO_MANAGER_DISABLE_TESTS) ||
+	    fcw_skip_tests() ||
 	    (alg->cra_flags & CRYPTO_ALG_INTERNAL))
 		return NULL; /* No self-test needed */
 
@@ -1022,6 +1024,9 @@ static void __init crypto_start_tests(void)
 	if (IS_ENABLED(CONFIG_CRYPTO_MANAGER_DISABLE_TESTS))
 		return;
 
+	if (fcw_skip_tests())
+		return;
+
 	set_crypto_boot_test_finished();
 
 	for (;;) {

 crypto/Makefile             | 137 ++++++++++++++++++++++++++++++------
 include/linux/scatterlist.h |   4 ++
 init/main.c                 |   3 +
 lib/crypto/Makefile         |  17 +----
 lib/crypto/mpi/Makefile     |  28 --------
 6 files changed, 123 insertions(+), 85 deletions(-)

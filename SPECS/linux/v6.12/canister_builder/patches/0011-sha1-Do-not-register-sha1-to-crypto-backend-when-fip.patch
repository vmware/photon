From 1a194ba0fabf048be0a2a7262d48d3538674717f Mon Sep 17 00:00:00 2001
From: Vamsi Krishna Brahmajosyula <vamsi-krishna.brahmajosyula@broadcom.com>
Date: Thu, 5 Jun 2025 23:39:23 -0500
Subject: [PATCH 11/13] sha1: Do not register sha1 to crypto backend when fips
 is enabled

---
 crypto/sha1_generic.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/crypto/sha1_generic.c b/crypto/sha1_generic.c
index 325b57fe2..24ab7da36 100644
--- a/crypto/sha1_generic.c
+++ b/crypto/sha1_generic.c
@@ -18,6 +18,7 @@
 #include <linux/types.h>
 #include <crypto/sha1.h>
 #include <crypto/sha1_base.h>
+#include <linux/fips.h>
 #include <asm/byteorder.h>
 
 const u8 sha1_zero_message_hash[SHA1_DIGEST_SIZE] = {
@@ -78,12 +79,16 @@ static struct shash_alg alg = {
 
 static int __init sha1_generic_mod_init(void)
 {
-	return crypto_register_shash(&alg);
+	if (!fips_enabled)
+		return crypto_register_shash(&alg);
+	else
+		return 0;
 }
 
 static void __exit sha1_generic_mod_fini(void)
 {
-	crypto_unregister_shash(&alg);
+	if (!fips_enabled)
+		crypto_unregister_shash(&alg);
 }
 
 subsys_initcall(sha1_generic_mod_init);
-- 
2.50.1


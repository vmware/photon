+/* Copyright (C) 2025 Broadcom, Inc. */
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+/* Structure member definition */
+struct struct_member {
+	char name[64];
+	/* Type, e.g int, char, enum, etc */
+	char type_name[64];
+	size_t byte_size;
+	int byte_offset;
+};
+
+/* Structure definition */
+struct struct_def {
+	char name[64];
+	size_t byte_size;
+	int nr_members;
+	/* Internal total size of the struct, including all struct members */
+	size_t __sz;
+	struct struct_member members[];
+};
+
+#define first_member(_def) &_def->members[0]
+
+#define for_all_members(_def, _mbr)                              \
+	int _i = 0; \
+	for (_mbr = first_member(_def); _i < _def->nr_members; _mbr = &_def->members[++_i]) \
+
+
+int init_db_from_canister(void);
+void free_structure_db(void);
+struct struct_def *get_struct_def_by_name(const char *name, int name_len);
+struct struct_member *get_first_member(struct struct_def *def);
+struct struct_member *get_member_by_name(struct struct_def *def, const char *name);
+int add_struct_def(struct struct_def *new_struct);
+struct struct_def *get_struct_def_by_name(const char *name, int name_len);
+int init_struct_db(int nr_structs);
+int cache_structure_db(void);
+int get_cached_db(void);
+
+#if defined(__cplusplus)
+}
+#endif
diff --git a/scripts/gcc-plugins/fips_canister_plugins/pad_canister_structs/pad_canister_structs.c b/scripts/gcc-plugins/fips_canister_plugins/pad_canister_structs/pad_canister_structs.c
new file mode 100644
index 000000000..275fd894a
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/pad_canister_structs/pad_canister_structs.c
@@ -0,0 +1,69 @@
+/*
+ * Pad all canister structures with X bytes
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+
+#include "gcc-common.h"
+#include "../fips_canister_common.h"
+#include "../constants.h"
+
+__visible int plugin_is_GPL_compatible;
+
+static void pad_struct(tree type, int pad_len) {
+	tree pad_field;
+
+	if(!struct_in_pad_list(ORIG_TYPE_NAME(type)))
+		return;
+
+	pad_field = create_padding_field(type, pad_len);
+
+	if(insert_pad_field(type, pad_field) < 0)
+		return;
+
+	relayout_canister_struct(type, PADDING_ADDED_ATTR);
+}
+
+static void before_struct_layout(void *event_data, void *data) {
+	tree type = (tree) event_data;
+
+	if (lookup_attribute(PADDING_ADDED_ATTR, TYPE_ATTRIBUTES(type)))
+		return;
+
+	if(!type_is_struct(type))
+		return;
+
+	pad_struct(type, 8);
+}
+
+static tree handle_padding_added_attr(tree *node, tree name, tree args, int flags, bool *no_add_attrs)
+{
+	*no_add_attrs = false;
+	return NULL_TREE;
+}
+
+static struct attribute_spec padding_added_attr = { };
+
+static void register_attributes(void *event_data, void *data)
+{
+	padding_added_attr.name 		= PADDING_ADDED_ATTR;
+	padding_added_attr.type_required	= true;
+	padding_added_attr.handler		= handle_padding_added_attr;
+	padding_added_attr.affects_type_identity = true;
+
+	register_attribute(&padding_added_attr);
+}
+
+int plugin_init(struct plugin_name_args *plugin_info, struct plugin_gcc_version *version)
+{
+
+	if(!lang_check(plugin_info->base_name, lang_hooks.name))
+		return 0;
+
+	register_callback(plugin_info->base_name, PLUGIN_BEFORE_STRUCT_LAYOUT, before_struct_layout, NULL);
+	register_callback(plugin_info->base_name, PLUGIN_ATTRIBUTES, register_attributes, NULL);

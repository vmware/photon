diff --git a/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/dwarf_debuginfo_parser.c b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/dwarf_debuginfo_parser.c
new file mode 100644
index 000000000..79bb93302
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/dwarf_debuginfo_parser.c
@@ -0,0 +1,267 @@
+/*
+ * Parse DWARF debuginfo from canister binary and extract structure information.
+ * Structure information can be returned via an API call
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+#include <stdlib.h>
+#include <dwarves/dwarves.h>
+#include <dwarves/dutil.h>
+#include <dwarves/list.h>
+#include <errno.h>
+
+#include "hash_table.h"
+#include "structure_db.h"
+#include "../constants.h"
+
+#define CANISTER_LOC "crypto/fips_canister.o"
+
+static struct conf_fprintf conf = {
+	.emit_stats = 1,
+};
+
+struct struct_def_entry {
+	struct struct_def *s_def;
+	struct list_head l_entry;
+};
+
+static struct list_head struct_list_head;
+
+static int returncode = 0;
+static int nr_structs;
+
+static void get_base_type_name(struct class_member *cls_member, struct cu *cu,
+			       char *buffer, int buf_len)
+{
+	char tmp_buf[64];
+	const char *tag_name;
+	struct tag *member_type = cu__type(cu, cls_member->tag.type);
+	struct base_type *bt = tag__base_type(member_type);
+
+	tag_name = tag__name(member_type, cu, tmp_buf, sizeof(tmp_buf), &conf);
+
+	if (tag_name)
+		strncpy(buffer, tag_name, buf_len);
+	else
+		strncpy(buffer, UNKWN_TYPE, buf_len);
+}
+
+static int parse_struct_member_tag(struct tag *tag,
+				   struct cu *cu,
+				   struct struct_member *new_member)
+{
+	struct class_member *cls_member;
+	char *tag_name;
+	struct base_type *base_type;
+	struct type *type;
+	struct tag *tag_pos;
+
+	cls_member = tag__class_member(tag);
+
+	if (cls_member->name)
+		strncpy(new_member->name, cls_member->name,
+			sizeof(new_member->name) - 1);
+	else
+		strncpy(new_member->name, ANON_NAME,
+			sizeof(new_member->name) - 1);
+
+	new_member->byte_size = cls_member->byte_size;
+	new_member->byte_offset = cls_member->byte_offset;
+	get_base_type_name(cls_member, cu, new_member->type_name,
+			   sizeof(new_member->type_name) - 1);
+
+	return 0;
+}
+
+/* If tag is a struct, parse it. Based off of __class__fprintf() */
+static struct struct_def *parse_tag(struct tag *tag, struct cu *cu)
+{
+	struct class *class;
+	struct type *type;
+	char name[64];
+	struct struct_def *new_struct;
+	struct struct_member *s_member;
+	struct tag *tag_pos;
+	const char *type_name;
+	int i;
+	size_t new_struct_sz;
+
+	if (!tag__is_struct(tag))
+		return NULL;
+
+	class = tag__class(tag);
+	type = &class->type;
+	type_name = type__name(type);
+
+	/* Don't bother with anonymous structures */
+	if (!type_name)
+		return NULL;
+
+	new_struct_sz = sizeof(struct struct_def) +
+				(type->nr_members * sizeof(struct struct_member));
+	new_struct = calloc(1, new_struct_sz);
+	if (!new_struct) {
+		perror("Failed to allocate memory for new struct!");
+		return NULL;
+	}
+
+	strncpy(new_struct->name, type_name, sizeof(new_struct->name) - 1);
+	new_struct->byte_size = type->size;
+	new_struct->nr_members = type->nr_members;
+	new_struct->__sz = new_struct_sz;
+
+	/*
+	 * Get the struct members.
+	 * According to DWARF format, the members of the struct should be
+	 * separate tags under the parent struct tag.
+	 * This loops through all the child tags for the struct.
+	 */
+	i = 0;
+	type__for_each_tag(type, tag_pos)
+	{
+		if (parse_struct_member_tag(tag_pos, cu, &new_struct->members[i]) < 0) {
+			fprintf(stderr,
+				"struct %s: Failed to parse tag for struct member\n",
+				new_struct->name);
+			free(new_struct);
+			return NULL;
+		}
+
+		i++;
+	}
+
+	/*
+	 * Debuginfo can contain some structs with no member info. Don't add
+	 * these to the DB.
+	 */
+	if(i == 0) {
+		free(new_struct);
+		return NULL;
+	}
+
+	return new_struct;
+}
+
+
+
+static void free_struct_def_list(void) {
+	struct struct_def_entry *pos, *tmp;
+	list_for_each_entry_safe(pos, tmp, &struct_list_head, l_entry) {
+		list_del(&pos->l_entry);
+		free(pos);
+	}
+}
+
+static int cu__parse_structs(struct cu *cu)
+{
+	int i;
+	struct tag *tag;
+	struct class *class;
+	const char *type_name;
+	struct struct_def_entry *pos, *new_entry;
+	bool unique;
+	struct struct_def *def;
+
+	cu__for_each_type(cu, i, tag) {
+		def = parse_tag(tag, cu);
+		if(!def)
+			continue;
+
+		unique = true;
+		list_for_each_entry(pos, &struct_list_head, l_entry) {
+			if(!strcmp(pos->s_def->name, def->name)) {
+				unique = false;
+				break;
+			}
+		}
+
+		if(!unique)
+			continue;
+
+		new_entry = calloc(1, sizeof(struct struct_def_entry));
+		if(!new_entry) {
+			perror("Failed to allocate memory for tag list entry");
+			returncode = -1;
+			return -1;
+		}
+
+		new_entry->s_def = def;
+		list_add_tail(&new_entry->l_entry, &struct_list_head);
+		nr_structs++;
+	}
+
+	return 0;
+}
+
+static enum load_steal_kind
+dwarf_struct_parser(struct cu *cu, struct conf_load *conf_load __maybe_unused,
+		     void *thr_data __maybe_unused)
+{
+	if (cu__parse_structs(cu) < 0)
+		return LSK__STOP_LOADING;
+
+	return LSK__DELETE;
+}
+
+struct conf_load dwarf_conf_parser = {
+	.steal = dwarf_struct_parser,
+	.conf_fprintf = &conf,
+};
+
+/*
+ * API call to initialize the database with the structure info.
+ */
+int init_db_from_canister(void)
+{
+	struct cus *cus = NULL;
+	int ret = 0;
+	struct struct_def_entry *pos;
+
+	if(get_cached_db() == 0)
+		return 0;
+
+	cus = cus__new();
+
+	if (dwarves__init() || cus == NULL) {
+		fprintf(stderr, "dwarf_debuginfo_parser: insufficient memory, "
+				"can't parse canister debuginfo\n");
+		return -1;
+	}
+
+	/*
+	 * Pass in 0 to read cacheline size from the build machine.
+	 * Assuming not cross-compiling, this should be accurate.
+	 * Most of the time, it will be 64 bytes anyways.
+	 */
+	dwarves__resolve_cacheline_size(&dwarf_conf_parser, 0);
+
+	INIT_LIST_HEAD(&struct_list_head);
+
+	ret = cus__load_file(cus, &dwarf_conf_parser, CANISTER_LOC);
+	if(ret < 0 || returncode < 0)
+		goto exit;
+
+	ret = init_struct_db(nr_structs);
+	if(ret < 0)
+		goto exit;
+
+	list_for_each_entry(pos, &struct_list_head, l_entry)
+		add_struct_def(pos->s_def);
+
+exit:
+	free_struct_def_list();
+	cus__delete(cus);
+	dwarves__exit();
+
+	if(ret < 0)
+		fprintf(stderr,
+			"Failed to read debuginfo from " CANISTER_LOC " : %s\n",
+			errno ? strerror(errno) : "No debugging information found");
+
+	if (ret < 0 || returncode < 0) {
+		free_structure_db();
+		return -1;
+	}
+
+	return 0;
+}
diff --git a/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/hash_table.c b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/hash_table.c
new file mode 100644
index 000000000..8eea90a8b
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/hash_table.c
@@ -0,0 +1,125 @@
+/*
+ * Basic hash table implementation for storing structure definitions
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+
+#include "hash_table.h"
+#include <stddef.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+
+#define FNV_OFFSET 14695981039346656037UL
+#define FNV_PRIME 1099511628211UL
+
+/*
+ * https://en.wikipedia.org/wiki/Fowler%E2%80%93Noll%E2%80%93Vo_hash_function
+ * This is simple to implement, but there may be faster hash functions
+ * out there
+ */
+static long unsigned int hash_string(const char *str, int len)
+{
+	long unsigned int hash = FNV_OFFSET;
+	for (int i = 0; i < len; i++) {
+		hash = hash * FNV_PRIME;
+		hash = hash ^ str[i];
+	}
+
+	return hash;
+}
+
+struct hash_table *alloc_hash_table(int num_entries)
+{
+	struct hash_table *table;
+	struct hash_table_entry *entries;
+
+	if(num_entries <= 0) {
+		fprintf(stderr,
+			"Can't allocate hash table with %d entries!\n",
+			num_entries);
+		return NULL;
+	}
+
+	/* Much better performance with some empty spaces */
+	num_entries = num_entries * 2;
+
+	table = calloc(1, sizeof(struct hash_table) +
+			(num_entries * sizeof(struct hash_table_entry)));
+	if (!table) {
+		perror("Failed to allocate memory for hash table");
+		return NULL;
+	}
+
+	table->num_entries = num_entries;
+
+	return table;
+}
+
+int hash_table_insert(struct hash_table *htable, void *entry, const char *key,
+		      int key_len)
+{
+	unsigned index, start_index;
+	struct hash_table_entry *htable_entry;
+
+	index = hash_string(key, key_len) % htable->num_entries;
+
+	start_index = index;
+	while(!entry_is_empty(&htable->entries[index])) {
+		if (index >= htable->num_entries - 1)
+			index = 0;
+		else
+			index++;
+
+		if(index == start_index) {
+			fprintf(stderr,
+				"No space remaining in hash table! No open entry slots!\n");
+			return -1;
+		}
+	}
+
+	htable_entry = &htable->entries[index];
+	strncpy(htable_entry->key, key, sizeof(htable_entry->key) - 1);
+	htable_entry->entry = entry;
+
+	return 0;
+}
+
+struct hash_table_entry *hash_table_get(struct hash_table *htable,
+					const char *key, int key_len)
+{
+	int index, start_index;
+	struct hash_table_entry *htable_entry;
+
+	index = hash_string(key, key_len) % htable->num_entries;
+	start_index = index;
+
+	do {
+		htable_entry = &htable->entries[index];
+		if (!strcmp(key, htable_entry->key))
+			return htable_entry;
+
+		if (index >= htable->num_entries - 1)
+			index = 0;
+		else
+			index++;
+
+	} while (index != start_index);
+
+	return NULL;
+}
+
+void hash_table_free(struct hash_table *hash_table, void (*free_entry)(void *))
+{
+	if (!hash_table)
+		return;
+
+	for(int i = 0; i < hash_table->num_entries; i++) {
+		if(entry_is_empty(&hash_table->entries[i]))
+			return;
+
+		free_entry(hash_table->entries[i].entry);
+	}
+
+	free(hash_table);
+}
diff --git a/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/hash_table.h b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/hash_table.h
new file mode 100644

--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/constants.h
@@ -0,0 +1,11 @@
+/* Copyright (C) 2025 Broadcom, Inc. */
+
+/* Used for struct members which have no name */
+#define ANON_NAME "anonymous"
+
+#define PAD_FIELD_NAME "__fips_canister_padding"
+
+#define PADDING_ADDED_ATTR "padding_added"
+#define CANISTER_MATCHED_ATTR "canister_matched"
+
+#define UNKWN_TYPE "<unknown>"
diff --git a/scripts/gcc-plugins/fips_canister_plugins/find_bad_casts.c b/scripts/gcc-plugins/fips_canister_plugins/find_bad_casts.c
new file mode 100644
index 000000000..6114752d9
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/find_bad_casts.c
@@ -0,0 +1,360 @@
+/*
+ * Following code is taken/modified from randomize_layout_plugin.c. Much thanks to
+ * all developers of randomize_layout_plugin.c, who have already implemented this
+ * functionality in that plugin. There's no need to reinvent the wheel here.
+ *
+ * Adds a safety layer, to find bad casts between structures. This is important,
+ * because we are possibly reordering structures or adding new
+ * padding fields. And so, "bad" casts between different structure types
+ * may not line up in the way that they'd originally been written.
+ *
+ *
+ * One addition to randomize_layout_plugin: check_global_var_decl(). This is
+ * needed to check global variable assignments.
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+
+#include "constants.h"
+#include "../gcc-common.h"
+
+#define INFORM(loc, msg, ...)	inform(loc, "fips canister plugin: " msg, ##__VA_ARGS__)
+#define MISMATCH(loc, how, ...)	INFORM(loc, "casting modified canister structure pointer type (" how "): %qT and %qT\n", __VA_ARGS__)
+
+static bool canister_modified(tree type_attrs)
+{
+	return lookup_attribute(PADDING_ADDED_ATTR, type_attrs) ||
+		lookup_attribute(CANISTER_MATCHED_ATTR, type_attrs);
+
+}
+
+static void check_bad_casts_in_constructor(tree var, tree init)
+{
+	unsigned HOST_WIDE_INT idx;
+	tree field, val;
+	tree field_type, val_type;
+
+	FOR_EACH_CONSTRUCTOR_ELT(CONSTRUCTOR_ELTS(init), idx, field, val) {
+		if (TREE_CODE(val) == CONSTRUCTOR) {
+			check_bad_casts_in_constructor(var, val);
+			continue;
+		}
+
+		/* pipacs' plugin creates franken-arrays that differ from those produced by
+		   normal code which all have valid 'field' trees. work around this */
+		if (field == NULL_TREE)
+			continue;
+		field_type = TREE_TYPE(field);
+		val_type = TREE_TYPE(val);
+
+		if (TREE_CODE(field_type) != POINTER_TYPE || TREE_CODE(val_type) != POINTER_TYPE)
+			continue;
+
+		if (field_type == val_type)
+			continue;
+
+		field_type = TYPE_MAIN_VARIANT(strip_array_types(TYPE_MAIN_VARIANT(TREE_TYPE(field_type))));
+		val_type = TYPE_MAIN_VARIANT(strip_array_types(TYPE_MAIN_VARIANT(TREE_TYPE(val_type))));
+
+		if (field_type == void_type_node)
+			continue;
+		if (field_type == val_type)
+			continue;
+
+		if(!canister_modified(TYPE_ATTRIBUTES(val_type)) &&
+			!canister_modified(TYPE_ATTRIBUTES(field_type)))
+			continue;
+
+		MISMATCH(DECL_SOURCE_LOCATION(var), "constructor\n", TYPE_MAIN_VARIANT(field_type),
+				TYPE_MAIN_VARIANT(val_type));
+	}
+}
+
+static void check_global_var_decl(tree var) {
+	tree init;
+	tree var_type, init_type;
+
+	init = DECL_INITIAL(var);
+
+	if(init == NULL_TREE)
+		return;
+
+	init_type = TREE_TYPE(init);
+	var_type = TREE_TYPE(var);
+
+	if (TREE_CODE(init_type) != POINTER_TYPE || TREE_CODE(var_type) != POINTER_TYPE)
+		return;
+
+	init_type = TYPE_MAIN_VARIANT(strip_array_types(TYPE_MAIN_VARIANT(TREE_TYPE(init_type))));
+	var_type = TYPE_MAIN_VARIANT(strip_array_types(TYPE_MAIN_VARIANT(TREE_TYPE(var_type))));
+
+	if(!canister_modified(TYPE_ATTRIBUTES(var_type)) &&
+		!canister_modified(TYPE_ATTRIBUTES(init_type)))
+		return;
+
+	if(TREE_CODE(var_type) != RECORD_TYPE)
+		return;
+
+	if(TREE_CODE(init_type) == TREE_CODE(var_type))
+		return;
+
+	MISMATCH(DECL_SOURCE_LOCATION(var), "global declaration", TYPE_MAIN_VARIANT(var_type),
+			TYPE_MAIN_VARIANT(init_type));
+}
+
+/* derived from the constify plugin */
+static void check_global_variables(void *event_data, void *data)
+{
+	struct varpool_node *node;
+	tree init;
+
+	FOR_EACH_VARIABLE(node) {
+		tree var = NODE_DECL(node);
+
+		if(TREE_CODE(var) == VAR_DECL){
+			check_global_var_decl(var);
+			continue;
+		}
+
+		init = DECL_INITIAL(var);
+		if (init == NULL_TREE)
+			continue;
+
+		if (TREE_CODE(init) != CONSTRUCTOR)
+			continue;
+
+		check_bad_casts_in_constructor(var, init);
+	}
+}
+
+/* Copied from gcc/dominance.cc */
+static inline unsigned int dom_convert_dir_to_idx (cdi_direction dir)
+{
+  gcc_checking_assert (dir == CDI_DOMINATORS || dir == CDI_POST_DOMINATORS);
+  return dir - 1;
+}
+
+static bool has_dominator(enum cdi_direction dir, basic_block bb) {
+	unsigned int dir_index = dom_convert_dir_to_idx (dir);
+	if(dir_index > 1 || !bb->dom[dir_index])
+		return false;
+
+	return true;
+}
+
+static bool dominated_by_is_err(const_tree rhs, basic_block bb)
+{
+	basic_block dom;
+	gimple dom_stmt;
+	gimple call_stmt;
+	const_tree dom_lhs;
+	const_tree poss_is_err_cond;
+	const_tree poss_is_err_func;
+	const_tree is_err_arg;
+
+	/*
+	 * Attempting to get the dominator without first checking if it exists
+	 * is causing SEGFAULT in some GCC test cases, for example
+	 * gcc.dg/gimplefe-49.c.
+	 *
+	 * Add our own function to check if the dominator exists first. Skip
+	 * out if it doesn't exist.
+	 */
+	if(!has_dominator(CDI_DOMINATORS, bb))
+		return false;
+
+	dom = get_immediate_dominator(CDI_DOMINATORS, bb);
+	if (!dom)
+		return false;
+
+	dom_stmt = last_stmt(dom);
+	if (!dom_stmt)
+		return false;
+
+	if (gimple_code(dom_stmt) != GIMPLE_COND)
+		return false;
+
+	if (gimple_cond_code(dom_stmt) != NE_EXPR)
+		return false;
+
+	if (!integer_zerop(gimple_cond_rhs(dom_stmt)))
+		return false;
+
+	poss_is_err_cond = gimple_cond_lhs(dom_stmt);
+
+	if (TREE_CODE(poss_is_err_cond) != SSA_NAME)
+		return false;
+
+	call_stmt = SSA_NAME_DEF_STMT(poss_is_err_cond);
+
+	if (gimple_code(call_stmt) != GIMPLE_CALL)
+		return false;
+
+	dom_lhs = gimple_get_lhs(call_stmt);
+	poss_is_err_func = gimple_call_fndecl(call_stmt);
+	if (!poss_is_err_func)
+		return false;
+	if (dom_lhs != poss_is_err_cond)
+		return false;
+	if (strcmp(DECL_NAME_POINTER(poss_is_err_func), "IS_ERR"))
+		return false;
+
+	is_err_arg = gimple_call_arg(call_stmt, 0);
+	if (!is_err_arg)
+		return false;
+
+	if (is_err_arg != rhs)
+		return false;
+
+	return true;
+}
+
+static void handle_local_var_initializers(void)
+{
+	tree var;
+	unsigned int i;
+
+	FOR_EACH_LOCAL_DECL(cfun, i, var) {
+		tree init = DECL_INITIAL(var);
+		if (!init)
+			continue;
+		if (TREE_CODE(init) != CONSTRUCTOR)
+			continue;
+		check_bad_casts_in_constructor(var, init);
+	}
+}
+
+/*
+ * iterate over all statements to find "bad" casts:
+ * those where the address of the start of a structure is cast
+ * to a pointer of a structure of a different type, or a
+ * structure pointer type is cast to a different structure pointer type
+ */
+static unsigned int find_bad_casts_execute(void)
+{
+	basic_block bb;
+
+	handle_local_var_initializers();
+
+	FOR_EACH_BB_FN(bb, cfun) {
+		gimple_stmt_iterator gsi;
+
+		for (gsi = gsi_start_bb(bb); !gsi_end_p(gsi); gsi_next(&gsi)) {
+			gimple stmt;
+			const_tree lhs;
+			const_tree lhs_type;
+			const_tree rhs1;
+			const_tree rhs_type;
+			const_tree ptr_lhs_type;
+			const_tree ptr_rhs_type;
+			const_tree op0;
+			const_tree op0_type;
+			enum tree_code rhs_code;
+
+			stmt = gsi_stmt(gsi);
+
+#ifdef __DEBUG_PLUGIN
+#ifdef __DEBUG_VERBOSE
+			debug_gimple_stmt(stmt);
+			debug_tree(gimple_get_lhs(stmt));
+#endif
+#endif
+
+			if (gimple_code(stmt) != GIMPLE_ASSIGN)
+				continue;
+
+#ifdef __DEBUG_PLUGIN
+#ifdef __DEBUG_VERBOSE
+			debug_tree(gimple_assign_rhs1(stmt));
+#endif
+#endif
+			rhs_code = gimple_assign_rhs_code(stmt);
+
+			if (rhs_code != ADDR_EXPR && rhs_code != SSA_NAME)
+				continue;
+
+			lhs = gimple_get_lhs(stmt);
+			lhs_type = TREE_TYPE(lhs);
+			rhs1 = gimple_assign_rhs1(stmt);
+			rhs_type = TREE_TYPE(rhs1);
+
+			if (TREE_CODE(rhs_type) != POINTER_TYPE ||
+				TREE_CODE(lhs_type) != POINTER_TYPE)
+				continue;
+
+			ptr_lhs_type = TYPE_MAIN_VARIANT(strip_array_types(TYPE_MAIN_VARIANT(TREE_TYPE(lhs_type))));
+			ptr_rhs_type = TYPE_MAIN_VARIANT(strip_array_types(TYPE_MAIN_VARIANT(TREE_TYPE(rhs_type))));
+
+			if (ptr_rhs_type == void_type_node)
+				continue;
+
+			if (ptr_lhs_type == void_type_node)
+				continue;
+
+			if (dominated_by_is_err(rhs1, bb))
+				continue;
+
+			if (TREE_CODE(ptr_rhs_type) != RECORD_TYPE) {
+#ifndef __DEBUG_PLUGIN
+				if (canister_modified(TYPE_ATTRIBUTES(ptr_lhs_type)))
+#endif
+				MISMATCH(gimple_location(stmt), "rhs", ptr_lhs_type,
+						ptr_rhs_type);
+				continue;
+			}
+
+			if (rhs_code == SSA_NAME && ptr_lhs_type == ptr_rhs_type)
+				continue;
+
+			if (rhs_code == ADDR_EXPR) {
+				op0 = TREE_OPERAND(rhs1, 0);
+
+				if (op0 == NULL_TREE)
+					continue;
+
+				if (TREE_CODE(op0) != VAR_DECL)
+					continue;
+
+				op0_type = TYPE_MAIN_VARIANT(strip_array_types(TYPE_MAIN_VARIANT(TREE_TYPE(op0))));
+				if (op0_type == ptr_lhs_type)
+					continue;
+
+#ifndef __DEBUG_PLUGIN
+				if (canister_modified(TYPE_ATTRIBUTES(op0_type)))
+#endif
+				MISMATCH(gimple_location(stmt), "op0", ptr_lhs_type, op0_type);
+			} else {
+				const_tree ssa_name_var = SSA_NAME_VAR(rhs1);
+				/* skip bogus type casts introduced by container_of */
+				if (ssa_name_var != NULL_TREE && DECL_NAME(ssa_name_var) &&
+				    !strcmp((const char *)DECL_NAME_POINTER(ssa_name_var), "__mptr"))
+					continue;
+#ifndef __DEBUG_PLUGIN
+				if(canister_modified(TYPE_ATTRIBUTES(ptr_rhs_type)))
+#endif
+				MISMATCH(gimple_location(stmt), "ssa", ptr_lhs_type,
+						ptr_rhs_type);
+			}
+
+		}
+	}
+	return 0;
+}
+
+#define PASS_NAME find_bad_casts
+#define NO_GATE
+#include "../gcc-generate-gimple-pass.h"
+void register_bad_casts_pass(const char* plugin_name)
+{
+	struct register_pass_info find_bad_casts_pass_info;
+
+	find_bad_casts_pass_info.pass			= make_find_bad_casts_pass();
+	find_bad_casts_pass_info.reference_pass_name	= "ssa";
+	find_bad_casts_pass_info.ref_pass_instance_number	= 1;
+	find_bad_casts_pass_info.pos_op			= PASS_POS_INSERT_AFTER;
+
+	register_callback(plugin_name, PLUGIN_PASS_MANAGER_SETUP,
+			NULL, &find_bad_casts_pass_info);
+	register_callback(plugin_name, PLUGIN_ALL_IPA_PASSES_START,
+			check_global_variables, NULL);
+}
diff --git a/scripts/gcc-plugins/fips_canister_plugins/fips_canister_common.c b/scripts/gcc-plugins/fips_canister_plugins/fips_canister_common.c
new file mode 100644
index 000000000..db836e43d
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/fips_canister_common.c
@@ -0,0 +1,370 @@
+/*
+ * Common code shared between match_canister_structs and pad_canister_structs.
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+
+#include "../gcc-common.h"
+
+#include "fips_canister_common.h"
+#include "constants.h"
+
+static const int nr_pad_structs = 44;
+const char *pad_struct_list[] = {
+	"crypto_async_request",
+	"crypto_tfm",
+	"cipher_alg",
+	"compress_alg",
+	"crypto_alg",
+	"crypto_aes_ctx",
+	"skcipher_request",
+	"crypto_skcipher",
+	"skcipher_alg_common",
+	"skcipher_alg",
+	"skcipher_walk",
+	"aead_request",
+	"aead_alg",
+	"crypto_aead",
+	"sha256_state",
+	"aead_geniv_ctx",
+	"crypto_sync_skcipher",
+	"rng_alg",
+	"crypto_rng",
+	"gcry_mpi",
+	"rsa_key",
+	"akcipher_request",
+	"crypto_akcipher",
+	"akcipher_alg",
+	"ecc_point",
+	"ecc_curve",
+	"crypto_wait",
+	"crypto_comp",
+	"hash_alg_common",
+	"ahash_request",
+	"crypto_ahash",
+	"shash_desc",
+	"crypto_shash",
+	"shash_alg",
+	"kpp_request",
+	"crypto_kpp",
+	"kpp_alg",
+	"acomp_req",
+	"crypto_acomp",
+	"crypto_cipher",
+	"sha1_state",
+	"sha512_state",
+	"sha3_state",
+	"ecdh"
+};
+
+/* TODO, future work: This is slow. Make it faster. */
+bool struct_in_pad_list(const char *name)
+{
+	for (int i = 0; i < nr_pad_structs; i++) {
+		if (!strcmp(name, pad_struct_list[i]))
+			return true;
+	}
+
+	return 0;
+}
+
+/* Borrowed from randomize_layout_plugin.c */
+bool is_flexible_array(const_tree field)
+{
+	const_tree fieldtype;
+	const_tree typesize;
+
+	fieldtype = TREE_TYPE(field);
+	typesize = TYPE_SIZE(fieldtype);
+
+	if (TREE_CODE(fieldtype) != ARRAY_TYPE)
+		return false;
+
+	/* size of type is represented in bits */
+
+	if (typesize == NULL_TREE && TYPE_DOMAIN(fieldtype) != NULL_TREE &&
+	    TYPE_MAX_VALUE(TYPE_DOMAIN(fieldtype)) == NULL_TREE)
+		return true;
+
+	return false;
+}
+
+tree create_padding_field(tree context, int pad_len)
+{
+	tree eltype, index, padding;
+
+	if (pad_len <= 0)
+		return NULL_TREE;
+
+	/* Type of array fields */
+	eltype = build_type_variant(char_type_node, 0, 0);
+
+	/* Maximum index into the array*/
+	index = build_index_type(size_int(pad_len - 1));
+
+	/* Build the new array type */
+	padding = build_array_type(eltype, index);
+
+	/* Build the new declaration */
+	padding = build_decl(BUILTINS_LOCATION, FIELD_DECL,
+			     get_identifier(PAD_FIELD_NAME), padding);
+
+	/* Context is the parent struct */
+	DECL_CONTEXT(padding) = context;
+
+	/* Relayout the new decl */
+	relayout_decl(padding);
+
+	return padding;
+}
+
+location_t get_type_location(tree type)
+{
+	if (!type)
+		return UNKNOWN_LOCATION;
+
+	if (DECL_P(type))
+		return DECL_SOURCE_LOCATION(type);
+
+	if (EXPR_HAS_LOCATION(type))
+		return EXPR_LOCATION(type);
+
+	return UNKNOWN_LOCATION;
+}
+
+size_t get_type_size(tree type)
+{
+	tree size_tree;
+	size_t size;
+
+	size_tree = TYPE_SIZE_UNIT(type);
+	size = size_tree ? TREE_INT_CST_LOW(size_tree) : 0;
+
+	return size;
+}
+
+size_t get_field_size(tree field)
+{
+	tree size_tree;
+	size_t field_size;
+
+	size_tree = TYPE_SIZE_UNIT(TREE_TYPE(field));
+	field_size = size_tree ? TREE_INT_CST_LOW(size_tree) : 0;
+
+	return field_size;
+}
+
+const char *get_field_name(tree field)
+{
+	const char *field_name;
+
+	field_name = get_name(field);
+	if (!field_name)
+		field_name = ANON_NAME;
+
+	return field_name;
+}
+
+/* TODO: Future work: improve this function, use it for variable type check */
+int get_field_type_str(tree field, char *type_str, int len)
+{
+	const char *type_name = NULL;
+
+	FILE *tmp_fp;
+	char* buf;
+	size_t length;
+
+	tree type;
+	tree type_name_node;
+
+	type = TREE_TYPE(field);
+
+	if (!type)
+		return 0;
+
+	type_name_node = TYPE_NAME(type);
+
+	if (type_name_node && TREE_CODE(type_name_node) == TYPE_DECL) {
+		type_name = IDENTIFIER_POINTER(DECL_NAME(type_name_node));
+	} else if (type_name_node &&
+		   TREE_CODE(type_name_node) == IDENTIFIER_NODE) {
+		type_name = get_name(type_name_node);
+	}
+
+	if(type_name) {
+		strncpy(type_str, type_name, len);
+		return 0;
+	}
+
+	tmp_fp = open_memstream(&buf, &length);
+	if(tmp_fp) {
+		print_generic_expr(tmp_fp, type, TDF_SLIM);
+		fflush(tmp_fp);
+		fclose(tmp_fp);
+		strncpy(type_str, buf, len);
+		free(buf);
+		return 0;
+	}
+
+	type_name = UNKWN_TYPE;
+	strncpy(type_str, type_name, len);
+
+	return 0;
+}
+
+int insert_pad_field(tree type, tree pad_field)
+{
+	tree last_field = NULL_TREE;
+	tree penultimate_field = NULL_TREE;
+	tree field;
+
+	if (!pad_field)
+		return 0;
+
+	for (field = TYPE_FIELDS(type); field; field = TREE_CHAIN(field)) {
+		penultimate_field = last_field;
+		last_field = field;
+	}
+
+	if (!last_field) {
+		error("No fields found for struct");
+		return -1;
+	}
+
+	if (!strcmp(get_field_name(last_field), PAD_FIELD_NAME))
+		return 0;
+
+	/* Add padding before flexible array member, as this must be the last member */
+	if (is_flexible_array(last_field)) {
+		if (!penultimate_field) {
+			error("must have at least 2 members when a flexible array member is present");
+			return -1;
+		}
+
+		TREE_CHAIN(penultimate_field) = pad_field;
+		TREE_CHAIN(pad_field) = last_field;
+	} else {
+		TREE_CHAIN(last_field) = pad_field;
+		TREE_CHAIN(pad_field) = NULL_TREE;
+	}
+
+	return 0;
+}
+
+void relayout_canister_struct(tree type, const char *identifier)
+{
+	tree main_variant, variant;
+
+	/* Relayout all variants in the same way */
+	main_variant = TYPE_MAIN_VARIANT(type);
+	for (variant = main_variant; variant; variant = TYPE_NEXT_VARIANT(variant)) {
+		TYPE_FIELDS(variant) = TYPE_FIELDS(type);
+
+		TYPE_ATTRIBUTES(variant) = copy_list(TYPE_ATTRIBUTES(variant));
+		TYPE_ATTRIBUTES(variant) = tree_cons(get_identifier(identifier),
+						     NULL_TREE,
+						     TYPE_ATTRIBUTES(variant));
+
+		/* Require designated initializers */
+		TYPE_ATTRIBUTES(variant) =
+			tree_cons(get_identifier("designated_init"), NULL_TREE,
+				  TYPE_ATTRIBUTES(variant));
+	}
+
+	/* Relayout with the updated size */
+	TYPE_SIZE(main_variant) = NULL_TREE;
+	TYPE_SIZE_UNIT(main_variant) = NULL_TREE;
+	layout_type(main_variant);
+}
+
+bool type_is_struct(tree type)
+{
+	if (type == NULL_TREE || type == error_mark_node)
+		return false;
+
+	if (TREE_CODE(type) != RECORD_TYPE)
+		return false;
+
+	if (TYPE_FIELDS(type) == NULL_TREE)
+		return false;
+
+	return 1;
+}
+
+bool lang_check(const char* plugin_name, const char* lang_name) {
+	if (strncmp(lang_name, "GNU C", 5)) {
+		inform(UNKNOWN_LOCATION, G_("%s supports C only, not %s"),
+			plugin_name,
+			lang_name);
+		return false;
+	}
+
+	return true;
+}
+
+/*
+ * Validate that the size of the struct with a flexible array
+ * is greater than the size of the basic struct definition, when declared
+ * as a constructor.
+ *
+ * As far as I can tell, this check shouldn't be necessary because
+ * the size of the flexible array is calculated when the declaration is
+ * parsed. But randomize_layout_plugin.c has some logic to reset the size
+ * of the flexible array struct at this point, and I can't figure out why.
+ * For now, just add a check and see if anything trips it.
+ */
+void validate_decl_flex_size(void *event_data, void *data)
+{
+	tree decl = (tree)event_data;
+	tree lastidx, field, init, type, flexsize;
+	unsigned HOST_WIDE_INT len;
+	size_t type_size;
+	size_t decl_size;
+
+	if (decl == NULL_TREE || decl == error_mark_node)
+		return;
+
+	type = TREE_TYPE(decl);
+
+	if (TREE_CODE(decl) != VAR_DECL)
+		return;
+
+	if (TREE_CODE(type) != RECORD_TYPE && TREE_CODE(type) != UNION_TYPE)
+		return;
+
+	if (!lookup_attribute(PADDING_ADDED_ATTR, TYPE_ATTRIBUTES(type)))
+		return;
+
+	gcc_assert(DECL_SIZE_UNIT(decl));
+
+	init = DECL_INITIAL(decl);
+	if (init == NULL_TREE || init == error_mark_node)
+		return;
+
+	if (TREE_CODE(init) != CONSTRUCTOR)
+		return;
+
+	len = CONSTRUCTOR_NELTS(init);
+	if (!len)
+		return;
+
+	lastidx = CONSTRUCTOR_ELT(init, CONSTRUCTOR_NELTS(init) - 1)->index;
+
+	for (field = TYPE_FIELDS(type); TREE_CHAIN(field);
+	     field = TREE_CHAIN(field))
+		;
+
+	if (lastidx != field)
+		return;
+
+	if (!is_flexible_array(field))
+		return;
+
+	decl_size = TREE_INT_CST_LOW(DECL_SIZE_UNIT(decl));
+	type_size = TREE_INT_CST_LOW(TYPE_SIZE_UNIT(type));
+
+	if (decl_size <= type_size)
+		error("struct '%s': declaration size (%ld) for a struct with a " \
+			"flexible array member must be > basic definition size (%ld)",
+		      ORIG_TYPE_NAME(type), decl_size, type_size);
+}

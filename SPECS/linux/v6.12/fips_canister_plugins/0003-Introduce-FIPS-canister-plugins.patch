--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/hash_table.h
@@ -0,0 +1,28 @@
+/* Copyright (C) 2025 Broadcom, Inc. */
+#include <stddef.h>
+
+struct hash_table_entry {
+	char key[64];
+	union {
+		void* entry;
+		size_t cache_ptr;
+	};
+};
+
+struct hash_table {
+	int num_entries;
+	struct hash_table_entry entries[];
+};
+
+static inline int entry_is_empty(struct hash_table_entry *htable_entry) {
+	return htable_entry->key[0] == '\0' && htable_entry->entry == 0;
+}
+
+struct hash_table *init_hash_table(int num_entries,
+				   void (*free_entry)(void *entry));
+int hash_table_insert(struct hash_table *htable, void *entry, const char *key,
+			int key_len);
+struct hash_table_entry *hash_table_get(struct hash_table *htable, const char *key,
+					 int key_len);
+struct hash_table *alloc_hash_table(int num_entries);
+void hash_table_free(struct hash_table *hash_table, void (*free_entry)(void *));
diff --git a/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/match_canister_structs.c b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/match_canister_structs.c
new file mode 100644
index 000000000..c333f04d6
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/match_canister_structs.c
@@ -0,0 +1,420 @@
+/*
+ * Using debuginfo from the canister binary, modify kernel structs to match
+ * canister structs.
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+
+#include "../../gcc-common.h"
+#include "structure_db.h"
+#include "../fips_canister_common.h"
+#include "../constants.h"
+
+__visible int plugin_is_GPL_compatible;
+
+static tree get_field_by_name(tree type, char *name)
+{
+	tree field;
+	const char *field_name;
+
+	for (field = TYPE_FIELDS(type); field; field = TREE_CHAIN(field)) {
+		field_name = get_field_name(field);
+		if (!strcmp(field_name, name))
+			return field;
+	}
+
+	return NULL_TREE;
+}
+
+static size_t calculate_struct_size(tree type)
+{
+	size_t cur_offset = 0;
+	size_t total_size;
+	size_t last_fld_size = 0, field_alignment = 0;
+	tree field;
+
+	for (field = TYPE_FIELDS(type); field; field = TREE_CHAIN(field)) {
+		field_alignment = DECL_ALIGN_UNIT(field);
+		if (!field_alignment)
+			field_alignment = 1;
+
+		cur_offset += last_fld_size;
+
+		/* Account for aligning offset on X byte boundary */
+		if (cur_offset && (cur_offset % field_alignment))
+			cur_offset = cur_offset -
+				     (cur_offset % field_alignment) +
+				     field_alignment;
+
+		last_fld_size = get_field_size(field);
+	}
+
+	return cur_offset + last_fld_size;
+}
+
+/* Validate offset of each field matches between kernel and canister */
+static int validate_offsets(tree type, struct struct_def *canister_def)
+{
+	size_t cur_offset = 0;
+	size_t total_size;
+	size_t last_fld_size = 0, field_alignment = 0;
+	struct struct_member *member;
+	tree field;
+	const char *field_name;
+	int padding_remaining = 0;
+	int i = 0;
+
+	for (member = first_member(canister_def), field = TYPE_FIELDS(type);
+		field && i < canister_def->nr_members;
+		field = TREE_CHAIN(field), member = &canister_def->members[++i]) {
+
+		field_alignment = DECL_ALIGN_UNIT(field);
+		if (!field_alignment)
+			field_alignment = 1;
+
+		field_name = get_field_name(field);
+
+		cur_offset += last_fld_size;
+
+		if (cur_offset && (cur_offset % field_alignment))
+			cur_offset = cur_offset -
+				     (cur_offset % field_alignment) +
+				     field_alignment;
+
+		last_fld_size = get_field_size(field);
+
+		if (!member)
+			continue;
+
+		if (!strcmp(member->name, field_name) &&
+		    cur_offset != (size_t)member->byte_offset) {
+			error("struct '%s': field '%s', kernel offset %ld != canister offset %d\n",
+			      canister_def->name, field_name, cur_offset,
+			      member->byte_offset);
+			return -1;
+		}
+
+	}
+
+	return 0;
+}
+
+/* Match field order between kernel and canister. Moves any new fields to end of the struct */
+static int order_fields(struct struct_def *canister_struct_def, tree type,
+			tree *new_field_order, int num_fields)
+{
+	size_t field_size;
+	struct struct_member *member;
+	tree field, flexible_array = NULL_TREE;
+	tree divergence_point = NULL_TREE;
+	int nr_anon = 0;
+	const char *field_name;
+	int nf_index = 0;
+	char field_type[64];
+
+	if (!first_member(canister_struct_def)) {
+		error("struct '%s': Found no members in canister version",
+		      canister_struct_def->name);
+		return -1;
+	}
+
+	/*
+	 * Simultaneously walk both canister and kernel struct fields/members.
+	 * If we encounter a difference, where the canister/kernel members at
+	 * a given index don't match, mark the divergence point and continue
+	 * parsing all the canister members.
+	 */
+	field = TYPE_FIELDS(type);
+	for_all_members(canister_struct_def, member) {
+		if (!strcmp(member->name, PAD_FIELD_NAME))
+			continue;
+
+retry_divergence:
+		if (divergence_point)
+			field = get_field_by_name(type, member->name);
+
+		/*
+		 * Removal of struct member in the kernel can cause incompatibility
+		 * issues with the canister, if canister code is attempting to
+		 * access data at some member/memory offset which the kernel
+		 * doesn't set.
+		*/
+		if (!field) {
+			error("struct %s: found canister member '%s' which is not "
+			      "present in kernel",
+			      canister_struct_def->name, member->name);
+			return -1;
+		}
+
+		field_name = get_field_name(field);
+		field_size = get_field_size(field);
+		get_field_type_str(field, field_type, sizeof(field_type));
+
+		if (strcmp(field_name, member->name)) {
+			divergence_point = field;
+			goto retry_divergence;
+		}
+
+		if (!strcmp(member->name, ANON_NAME))
+			nr_anon++;
+
+		gcc_assert(nf_index < num_fields);
+		if (is_flexible_array(field))
+			new_field_order[num_fields - 1] = field;
+		else
+			new_field_order[nf_index++] = field;
+
+		// TODO: Future development can also add a type check here.
+
+		if (field_size != member->byte_size) {
+			inform(DECL_SOURCE_LOCATION(field),
+			       "struct '%s': field '%s' size mismatch: "
+			       "kernel: (%s) %ld != canister: (%s) %ld\n",
+			       canister_struct_def->name, member->name,
+			       field_type, field_size, member->type_name,
+			       member->byte_size);
+		}
+
+		field = TREE_CHAIN(field);
+	}
+
+	/*
+	 * Iterate all kernel fields starting from the divergence point.
+	 * This ensures we won't miss any kernel fields, but don't have to start
+	 * over from the very beginning. Usually, the kernel/canister will
+	 * maintain the same order, but in some cases this is necessary. See
+	 * crypto_kpp from 6.1 to 6.12 for an example.
+	 */
+	if (divergence_point)
+		field = divergence_point;
+
+	/* Add any new fields which are not present in the canister version */
+	while (field && nf_index < num_fields) {
+		field_name = get_field_name(field);
+		if (!strcmp(field_name, ANON_NAME))
+			nr_anon++;
+
+		member = get_member_by_name(canister_struct_def, field_name);
+		if (!member)
+			new_field_order[nf_index++] = field;
+
+		if (is_flexible_array(field) && TREE_CHAIN(field) != NULL_TREE)
+			error("struct '%s': flexible array member must be final member",
+			      canister_struct_def->name);
+
+		field = TREE_CHAIN(field);
+	}
+
+	if (nr_anon > 1 && divergence_point) {
+		error("struct '%s': Can't handle more than one anonymous member"
+		      "when struct has been reordered between kernel/canister",
+		      canister_struct_def->name);
+		return -1;
+	}
+
+	return 0;
+}
+
+static int pad_struct(struct struct_def *canister_struct_def, tree type,
+		      int kernel_size)
+{
+	size_t padding_size;
+	tree pad_field = NULL_TREE;
+
+	padding_size = canister_struct_def->byte_size - kernel_size;
+	if ((int)padding_size > 0)
+		pad_field = create_padding_field(type, padding_size);
+
+	return insert_pad_field(type, pad_field);
+}
+
+static bool needs_matching(tree type, struct struct_def *canister_def)
+{
+	struct struct_member *member;
+	const char *field_name;
+	size_t field_size;
+	tree field;
+	int i = 0;
+
+	if(get_type_size(type) != canister_def->byte_size)
+		return true;
+
+	for (member = first_member(canister_def), field = TYPE_FIELDS(type);
+		field && i < canister_def->nr_members;
+		field = TREE_CHAIN(field), member = &canister_def->members[++i]) {
+
+		field_name = get_field_name(field);
+		field_size = get_field_size(field);
+
+		/* Needs processing if fields/field order differs, or size/type has changed */
+		if (strcmp(field_name, member->name) ||
+		    field_size != member->byte_size)
+			return true;
+	}
+
+	if (!strcmp(member->name, PAD_FIELD_NAME))
+		return true;
+
+	if (field || i < canister_def->nr_members)
+		return true;
+
+	return false;
+}
+
+/* Match kernel structures to canister structures */
+static void match_struct(tree type)
+{
+	tree *new_field_order;
+	int num_fields = 0;
+	struct struct_def *canister_struct_def;
+	const char *type_name;
+	size_t struct_size;
+
+	type_name = ORIG_TYPE_NAME(type);
+	if (!type_name || !strcmp(type_name, ANON_NAME))
+		return;
+
+	/*
+	 * hmac_ctx is a weird case. Defined differently in two separate places,
+	 * one inside the canister/kernel crypto/ and another inside the chelsio
+	 * driver.
+	 *
+	 * We can't validate the chelsio version against the the canister, because
+	 * it is intentionally different by design. Probably in the future, it
+	 * would make sense to sync the two definitions so that we can run the
+	 * compatibility checks in this plugin. But for now, skip it entirely.
+	 */
+	if(!strcmp(type_name, "hmac_ctx"))
+		return;
+
+	/* Calculate alignments and sizes for all fields */
+	layout_type(type);
+
+	canister_struct_def = get_struct_def_by_name(type_name, strlen(type_name));
+	if (!canister_struct_def) {
+		if (struct_in_pad_list(type_name))
+			error("struct '%s': in padding list but not found in canister debuginfo",
+			      type_name);
+		return;
+	}
+
+	if (!needs_matching(type, canister_struct_def))
+		return;
+
+	if (!struct_in_pad_list(type_name))
+		inform(get_type_location(type),
+		       "struct '%s': mismatch between kernel/canister versions, "
+		       "but not in padding list\n",
+		       type_name);
+
+	/* First pass - count fields. */
+	for (tree field = TYPE_FIELDS(type); field; field = TREE_CHAIN(field))
+		num_fields++;
+
+	/* Note: Can't use m/calloc in GCC */
+	new_field_order = (tree *) xcalloc(sizeof(tree), num_fields);
+	if (!new_field_order) {
+		perror("Couldn't allocate memory for new field order array!");
+		return;
+	}
+
+	/* Second pass - order the fields according to canister definition */
+	if (order_fields(canister_struct_def, type, new_field_order,
+			 num_fields) < 0)
+		goto err_exit;
+
+	/* Link fields according to the new order */
+	for (int i = 0; i < num_fields - 1; i++)
+		TREE_CHAIN(new_field_order[i]) = new_field_order[i + 1];
+	TREE_CHAIN(new_field_order[num_fields - 1]) = NULL_TREE;
+
+	TYPE_FIELDS(type) = new_field_order[0];
+
+	struct_size = calculate_struct_size(type);
+	if ((int)struct_size < 0)
+		goto err_exit;
+
+	/* Insert padding to match canister size, if necessary */
+	if (pad_struct(canister_struct_def, type, struct_size) < 0)
+		goto err_exit;
+
+	/* Relayout the modified structure */
+	relayout_canister_struct(type, CANISTER_MATCHED_ATTR);
+
+	/* Validate that offsets for each field are matching between kernel and canister */
+	if (validate_offsets(type, canister_struct_def) < 0)
+		goto err_exit;
+
+	/* Enforce structure size matching */
+	struct_size = get_type_size(TYPE_MAIN_VARIANT(type));
+	if (struct_size != canister_struct_def->byte_size) {
+		error("struct '%s': kernel size %ld != canister size %ld\n",
+		      canister_struct_def->name, struct_size,
+		      canister_struct_def->byte_size);
+		goto err_exit;
+	}
+
+err_exit:
+	free(new_field_order);
+}
+
+static void before_struct_layout(void *event_data, void *data)
+{
+	tree type = (tree) event_data;
+
+	if (lookup_attribute(CANISTER_MATCHED_ATTR, TYPE_ATTRIBUTES(type)))
+		return;
+
+	if (!type_is_struct(type))
+		return;
+
+	match_struct(type);
+}
+
+static tree handle_canister_matched_attr(tree *node, tree name, tree args,
+					 int flags, bool *no_add_attrs)
+{
+	*no_add_attrs = false;
+	return NULL_TREE;
+}
+
+static struct attribute_spec canister_matched_attr = {};
+
+static void register_attributes(void *event_data, void *data)
+{
+	canister_matched_attr.name = CANISTER_MATCHED_ATTR;
+	canister_matched_attr.type_required = true;
+	canister_matched_attr.handler = handle_canister_matched_attr;
+	canister_matched_attr.affects_type_identity = true;
+
+	register_attribute(&canister_matched_attr);
+}
+
+static void destroy_canister_struct_db(void *event_data, void *data)
+{
+	cache_structure_db();
+	free_structure_db();
+}
+
+int plugin_init(struct plugin_name_args *plugin_info,
+		struct plugin_gcc_version *version)
+{
+	if(!lang_check(plugin_info->base_name, lang_hooks.name))
+		return -1;
+
+	if (init_db_from_canister() < 0)
+		return -1;
+
+	register_callback(plugin_info->base_name, PLUGIN_BEFORE_STRUCT_LAYOUT,
+			  before_struct_layout, NULL);
+	register_callback(plugin_info->base_name, PLUGIN_ATTRIBUTES,
+			  register_attributes, NULL);
+	register_callback(plugin_info->base_name, PLUGIN_FINISH,
+			  destroy_canister_struct_db, NULL);
+	register_callback(plugin_info->base_name, PLUGIN_FINISH_DECL,
+			  validate_decl_flex_size, NULL);
+	register_bad_casts_pass(plugin_info->base_name);
+
+
+	return 0;
+}
diff --git a/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/structure_db.c b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/structure_db.c
new file mode 100644
index 000000000..95e88686a
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/structure_db.c
@@ -0,0 +1,231 @@
+/*
+ * API for structure database
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+
+#include "hash_table.h"
+#include "structure_db.h"
+#include <dwarves/list.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <stdbool.h>
+
+#define CACHE_LOC "scripts/gcc-plugins/canister_structures.db"
+
+/* Simpler to keep the DB reference here. */
+static struct struct_db {
+	bool cached;
+	struct hash_table *htable;
+	unsigned char *cache;
+	size_t cache_sz;
+} struct_table = {0};
+
+struct struct_def *get_struct_def_by_name(const char *name, int name_len)
+{
+	struct hash_table_entry *entry;
+
+	entry = hash_table_get(struct_table.htable, name, name_len);
+
+	if(!entry)
+		return NULL;
+
+	if(struct_table.cached) {
+		return (struct struct_def *) (struct_table.cache + entry->cache_ptr);
+	}
+
+	return (struct struct_def *) entry->entry;
+}
+
+struct struct_member *get_member_by_name(struct struct_def *def,
+					 const char *name)
+{
+	struct struct_member *member;
+
+	if (!name)
+		return NULL;
+
+	for_all_members(def, member) {
+		if (!strcmp(name, member->name))
+			return member;
+	}
+
+	return NULL;
+}
+
+static void free_struct_def(void *def)
+{
+	if (!def)
+		return;
+
+	free(def);
+}
+
+int add_struct_def(struct struct_def *new_struct)
+{
+	int ret;
+
+	ret = hash_table_insert(struct_table.htable, (void *)new_struct,
+					new_struct->name, strlen(new_struct->name));
+	if (ret < 0)
+		fprintf(stderr,
+			"Failed to insert new entry for %s into "
+			"structure definition hash table\n",
+			new_struct->name);
+
+	return ret;
+}
+
+int get_cached_db(void)
+{
+	int fd;
+	unsigned char *mem_block;
+	struct stat cache_stat;
+
+	fd = open(CACHE_LOC, O_RDONLY);
+	if(fd < 0) {
+		fprintf(stderr, "Cache not yet present at: %s\n", CACHE_LOC);
+		return -1;
+	}
+
+	if(fstat(fd, &cache_stat) < 0) {
+		close(fd);
+		return -1;
+	}
+
+	mem_block = mmap(NULL, cache_stat.st_size, PROT_READ, MAP_SHARED, fd, 0);
+	close(fd);
+
+	if(mem_block == MAP_FAILED) {
+		perror("Cache present but failed to load");
+		return -1;
+	}
+
+	struct_table.cached = true;
+	struct_table.htable = (struct hash_table*) mem_block;
+	struct_table.cache = mem_block;
+	struct_table.cache_sz = cache_stat.st_size;
+
+	return 0;
+}
+
+int init_struct_db(int nr_structs)
+{
+	struct_table.htable = alloc_hash_table(nr_structs);
+	if (!struct_table.htable) {
+		fprintf(stderr, "Failed to allocate memory for the structure "
+				"definition hash table\n");
+		return -1;
+	}
+
+	return 0;
+}
+
+void free_structure_db(void)
+{
+	if(struct_table.cached) {
+		if(munmap(struct_table.cache, struct_table.cache_sz) < 0)
+			perror("Failed to unmap cached structure db");
+	}
+	else
+		hash_table_free(struct_table.htable, free_struct_def);
+}
+
+/*
+ * Convert the initial hash table and all structure defintions into a memory
+ * block which can be stored as a cache and mapped directly in to other plugin
+ * invocations.
+ *
+ * The cache is organized in two sections:
+ * 	Section 1: Hash table
+ * 	Section 2: Generic memory block, used to store the structure
+ *	           definitions.
+ *
+ * We can use the same hash table, but for cache purposes we can convert the
+ * normal "hash_table_entry->entry" pointer to instead be an offset from the
+ * beginning of the cache.
+ */
+int cache_structure_db(void)
+{
+	FILE *cache;
+	size_t ret;
+	unsigned char *mem_block;
+	size_t cur_ptr = 0;
+	size_t table_sz = 0, heap_sz = 0;
+	struct struct_def *def;
+	struct hash_table *cached_table;
+
+	if(struct_table.cached)
+		return 0;
+
+	/* Measure size needed for memory block */
+	table_sz = sizeof(struct hash_table) +
+		(struct_table.htable->num_entries * sizeof(struct hash_table_entry));
+
+	for(int i = 0; i < struct_table.htable->num_entries; i++) {
+		if(entry_is_empty(&struct_table.htable->entries[i]))
+			continue;
+
+		def = (struct struct_def *) struct_table.htable->entries[i].entry;
+		heap_sz += def->__sz;
+	}
+
+	/* Allocate new memory block */
+	mem_block = calloc(1, table_sz + heap_sz);
+	if(!mem_block) {
+		perror("Failed to allocate memory block for cache");
+		return -1;
+	}
+
+	/* Populate new memory block */
+	/* Copy hash table into the first bytes */
+	memcpy(mem_block, struct_table.htable, table_sz);
+	cur_ptr += table_sz;
+
+	cached_table = (struct hash_table *) mem_block;
+
+	/*
+	 * For each structure definition entry, copy into the "heap" space and
+	 * save the ptr as the offset to the beginning of the memory block
+	 */
+	for(int i = 0; i < struct_table.htable->num_entries; i++) {
+		def = (struct struct_def *) struct_table.htable->entries[i].entry;
+		if(!def)
+			continue;
+
+		cached_table->entries[i].cache_ptr = cur_ptr;
+		memcpy(mem_block + cur_ptr, def, def->__sz);
+		cur_ptr += def->__sz;
+	}
+
+	if(cur_ptr > table_sz + heap_sz) {
+		fprintf(stderr, "Memory error: Cache overflow\n");
+		ret = -1;
+		goto finish;
+	}
+
+	cache = fopen(CACHE_LOC, "wb");
+	if(!cache) {
+		perror("Failed to open cache location");
+		ret = -1;
+		goto finish;
+	}
+
+	ret = fwrite(mem_block, table_sz + heap_sz, 1, cache);
+	if(ret <= 0) {
+		perror("Failed to write structure DB to cache");
+		ret = -1;
+	}
+
+	fclose(cache);
+finish:
+	free(mem_block);
+
+	return (int) ret;
+}
+

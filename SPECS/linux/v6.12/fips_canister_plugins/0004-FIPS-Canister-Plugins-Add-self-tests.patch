--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/add-multiple-new-fields.expected
@@ -0,0 +1,28 @@
+struct crypto_tfm {
+	char                       refcnt[4];            /*     0     4 */
+	int                        crt_flags;            /*     4     4 */
+	int                        node;                 /*     8     4 */
+
+	/* XXX 4 bytes hole, try to pack */
+
+	void                       (*exit)(struct crypto_tfm *); /*    16     8 */
+	void *                     __crt_alg;            /*    24     8 */
+	int                        new_field;            /*    32     4 */
+	int                        new_field1;           /*    36     4 */
+	void *                     __crt_ctx[] __attribute__((__aligned__(8))); /*    40     0 */
+
+	/* size: 40, cachelines: 1, members: 8 */
+	/* sum members: 36, holes: 1, sum holes: 4 */
+	/* forced alignments: 1 */
+	/* last cacheline: 40 bytes */
+} __attribute__((__aligned__(8)));
+struct ecdh {
+	char *                     key;                  /*     0     8 */
+	short unsigned int         key_size;             /*     8     2 */
+	char                       new_field[3];         /*    10     3 */
+	char                       __fips_canister_padding[11]; /*    13    11 */
+	char                       new_flexible_array[]; /*    24     0 */
+
+	/* size: 24, cachelines: 1, members: 5 */
+	/* last cacheline: 24 bytes */
+};

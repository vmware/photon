+	printf("new_field offset: %d\n", offsetof(struct crypto_tfm, new_field));
+	printf("refcnt offset: %d\n", offsetof(struct crypto_tfm, refcnt));
+	printf("crt_flags offset: %d\n", offsetof(struct crypto_tfm, crt_flags));
+	printf("node offset: %d\n", offsetof(struct crypto_tfm, node));
+	printf("exit offset: %d\n", offsetof(struct crypto_tfm, exit));
+	printf("__crt_alg offset: %d\n", offsetof(struct crypto_tfm, __crt_alg));
+	printf("__crt__ctx offset: %d\n", offsetof(struct crypto_tfm, __crt_ctx));

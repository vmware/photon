+#!/bin/bash
+source "self-test-lib.sh"
+
+for dir in */; do
+    if [[ -f "${dir}/self-test.sh" ]]; then
+        echo -e "\n\n ***** Running tests for $(basename "${dir}") *****"
+        pushd "$dir" || exit 1
+        ./self-test.sh || _TEST_FAILURE=1
+        popd || exit 1
+    fi
+done
+
+exit_return_code
diff --git a/scripts/gcc-plugins/fips_canister_plugins/self_tests/self-test-lib.sh b/scripts/gcc-plugins/fips_canister_plugins/self_tests/self-test-lib.sh
new file mode 100755
index 000000000000..e596a4287aa0
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/self_tests/self-test-lib.sh
@@ -0,0 +1,231 @@
+#!/bin/bash
+_TEST_FAILURE=0
+
+cleanup_files() {
+        local test_name="$1"
+
+        rm -f "${test_name}.output" \
+                "${test_name}.diff" \
+                "${test_name}.o"
+}
+
+failure() {
+        local test_name="$1"
+        local err_type="$2"
+
+        echo -e "\n********************** TEST FAIL: $test_name ************************"
+        if [[ "$err_type" = "gcc" ]]; then
+                echo "Failed to test ${test_name}.c"
+                cat "${test_name}.output"
+        elif [[ "$err_type" = "pahole" ]]; then
+                echo "pahole found difference between output and expected output:"
+                cat "${test_name}.diff"
+	elif [[ "$err_type" = "functional" ]]; then
+		echo "Functional test failure, see output diff below:"
+		cat "${test_name}.diff"
+        elif [[ "$err_type" = "expected_gcc" ]]; then
+                echo "Difference between GCC output and expected GCC output:"
+                cat "${test_name}.diff"
+        elif [[ "$err_type" = "expected_gcc_failure" ]]; then
+                echo "gcc passed unexpectedly: ${test_name}.c"
+        else
+                echo "INTERNAL TEST SUITE ERROR: failure() requires an err_type"
+        fi
+        echo "************************ END TEST: $test_name ********************"
+
+        cleanup_files "$test_name"
+        _TEST_FAILURE=1
+}
+
+test_flexible_array_init() {
+        local test_name="$1"
+        local plugin_path="$2"
+        local flex_array_size="$3"
+        local struct_var_name="$4"
+        local base_size=
+        local var_size=
+
+        echo "Test: ${test_name}"
+        gcc -c "${test_name}".c -O0 -ggdb -fplugin="${plugin_path}" -Werror=designated-init &> "${test_name}.output"
+        if [[ $? -ne 0 ]]; then
+                failure "$test_name" "gcc"
+                return
+        fi
+
+        if [[ -f "${test_name}.gcc.expected" ]]; then
+                diff -U 3 "${test_name}.gcc.expected" "${test_name}.output" &> "${test_name}.diff"
+        elif [[ -f "${test_name}.output" ]]; then
+                mv "${test_name}.output" "${test_name}.diff"
+        else
+                touch "${test_name}.diff"
+        fi
+
+        if [[ -s "${test_name}.diff" ]]; then
+                failure "$test_name" "expected_gcc"
+                return
+        fi
+
+        pahole "${test_name}".o &> "${test_name}.output"
+
+        diff -U 3 "${test_name}.expected" "${test_name}.output" &> "${test_name}.diff"
+
+        if [[ -s "${test_name}.diff" ]]; then
+                failure "$test_name" "pahole"
+                return
+        fi
+
+        base_size=$(grep -Eo "size: [0-9]+" "${test_name}.output")
+        base_size=$(cut -d " " -f 2 <<< "$base_size")
+
+        var_size=$(readelf -s "${test_name}.o" | grep "$struct_var_name" | awk '{print $3}')
+
+        cleanup_files "$test_name"
+
+        if [[ $var_size -ne $((base_size + flex_array_size)) ]]; then
+                echo -e "\n********************** TEST FAIL: $test_name ************************"
+                echo "Expected variable size for $struct_var_name: $((base_size + flex_array_size))"
+                echo "Found variable size: $var_size instead"
+                echo "************************ END TEST: $test_name ********************"
+                _TEST_FAILURE=1
+                return
+        fi
+
+        echo -e "${test_name}: Test passed successfully\n"
+}
+
+test_case () {
+    local test_name="$1"
+    local plugin_path="$2"
+
+    echo "Test: ${test_name}"
+    gcc -c "${test_name}".c -O0 -ggdb -fplugin="${plugin_path}" -Werror=designated-init &> "${test_name}.output"
+    if [[ $? -ne 0 ]]; then
+        failure "$test_name" "gcc"
+        return
+    fi
+
+    if [[ -f "${test_name}.gcc.expected" ]]; then
+        diff -U 3 "${test_name}.gcc.expected" "${test_name}.output" &> "${test_name}.diff"
+    elif [[ -f "${test_name}.output" ]]; then
+        mv "${test_name}.output" "${test_name}.diff"
+    else
+        touch "${test_name}.diff"
+    fi
+
+    if [[ -s "${test_name}.diff" ]]; then
+        failure "$test_name" "expected_gcc"
+        return
+    fi
+
+    pahole "${test_name}".o &> "${test_name}.output"
+
+    diff -U 3 "${test_name}.expected" "${test_name}.output" &> "${test_name}.diff"
+
+    if [[ -s "${test_name}.diff" ]]; then
+        failure "$test_name" "pahole"
+        return
+    fi
+
+    echo -e "$test_name: Test passed successfully\n"
+    cleanup_files "$test_name"
+}
+
+test_case_gcc_warning() {
+    local test_name="$1"
+    local plugin_path="$2"
+
+    echo "Test: ${test_name}"
+    gcc -c "${test_name}".c -O0 -ggdb -fplugin="${plugin_path}" -Werror=designated-init &> "${test_name}.output"
+    if [[ $? -ne 0 ]]; then
+        failure "$test_name" "gcc"
+        return
+    fi
+
+    diff -U 3 "${test_name}.gcc.expected" "${test_name}.output" &> "${test_name}.diff"
+
+    if [[ -s "${test_name}.diff" ]]; then
+        failure "$test_name" "expected_gcc"
+        return
+    fi
+
+    pahole "${test_name}".o &> "${test_name}.output"
+
+    diff -U 3 "${test_name}.expected" "${test_name}.output" &> "${test_name}.diff"
+
+    if [[ -s "${test_name}.diff" ]]; then
+        failure "$test_name" "pahole"
+        return
+    fi
+
+    echo -e "$test_name: Test passed successfully\n"
+        cleanup_files "$test_name"
+}
+
+test_case_expect_gcc_failure() {
+    local test_name="$1"
+    local plugin_path="$2"
+
+    echo "Test: ${test_name}"
+    gcc -c "${test_name}".c -O0 -ggdb -fplugin="${plugin_path}" -Werror=designated-init &> "${test_name}.output"
+    if [[ $? -eq 0 ]]; then
+        echo "************************ END TEST: $test_name ********************"
+        rm "${test_name}.output" "${test_name}.o"
+        _TEST_FAILURE=1
+        return
+    fi
+
+    diff -U 3 "${test_name}.expected" "${test_name}.output" &> "${test_name}.diff"
+
+    if [[ -s "${test_name}.diff" ]]; then
+        failure "$test_name" "expected_gcc"
+        return
+    fi
+
+    echo -e "$test_name: Test passed successfully\n"
+    cleanup_files "$test_name"
+}
+
+test_case_functional() {
+    local test_name="$1"
+    local plugin_path="$2"
+
+    echo "Test: ${test_name}"
+    gcc -o "$test_name.o" "${test_name}".c -O0 -ggdb -fplugin="${plugin_path}" -Werror=designated-init &> "${test_name}.output"
+    if [[ $? -ne 0 ]]; then
+	failure "$test_name" "gcc"
+	return
+    fi
+
+    if [[ -f "${test_name}.gcc.expected" ]]; then
+	diff -U 3 "${test_name}.gcc.expected" "${test_name}.output" &> "${test_name}.diff"
+    elif [[ -f "${test_name}.output" ]]; then
+	mv "${test_name}.output" "${test_name}.diff"
+    else
+	touch "${test_name}.diff"
+    fi
+
+    if [[ -s "${test_name}.diff" ]]; then
+	failure "$test_name" "expected_gcc"
+        return
+    fi
+
+    "./${test_name}.o" &> "${test_name}.output"
+    diff -U 3 "${test_name}.expected" "${test_name}.output" &> "${test_name}.diff"
+    if [[ -s "${test_name}.diff" ]]; then
+        failure "$test_name" "functional"
+        return
+    fi
+
+    echo -e "${test_name}: Test passed successfully\n"
+    cleanup_files "$test_name"
+}
+
+exit_return_code() {
+    if [[ "$_TEST_FAILURE" -ne 0 ]]; then
+        echo "SOME TESTS FAILED"
+    else
+        echo "ALL TESTS SUCCESSFUL"
+    fi
+
+    exit $_TEST_FAILURE
+}

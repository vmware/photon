+	char *key;
+	unsigned short key_size;
+};
+
+int main()
+{
+	struct ecdh ecdh;
+	size_t key_offset = offsetof(struct ecdh, key);
+	size_t key_size_offset = offsetof(struct ecdh, key_size);
+
+	// test offsets
+	printf("Offsets:\n");
+	printf("offsetof(ecdh.key) = %d\n", key_offset);
+	printf("offsetof(ecdh.key_size) = %d\n", key_size_offset);
+
+
+	unsigned short *key_sz = (unsigned short *) (((char* ) &ecdh) + 8);
+	*key_sz = 53;
+	printf("\necdh->key_sz = %d\n", ecdh.key_size);
+
+	return 0;
+}

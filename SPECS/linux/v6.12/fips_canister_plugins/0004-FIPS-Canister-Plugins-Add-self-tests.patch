+	// test explicitly writing to offset
+	int *node = (int*) (((long int) func_tfm) + 8);
+	*node = 75439;
+
+	printf("Explicit offset write: crypto_tfm->node = %d\n", func_tfm->node);
+
+	free(func_tfm);
+	return 0;
+}

+
+struct crypto_tfm {
+        char refcnt[4];
+
+        int crt_flags;
+
+        long int new_field;
+
+        int node;
+
+        void (*exit)(struct crypto_tfm *tfm);
+
+        void *__crt_alg;
+
+        void *__crt_ctx[] __attribute__((__aligned__(8)));
+};
+
+int main() {

+	.refcnt = {0},
+	.crt_flags = 1,
+	.node = 2,
+	.exit = 0,
+	.__crt_alg = 0,
+	// Alloc 8 bytes for the flexible array size
+	.__crt_ctx = {0, 1, 2, 3, 4, 5, 6, 7}

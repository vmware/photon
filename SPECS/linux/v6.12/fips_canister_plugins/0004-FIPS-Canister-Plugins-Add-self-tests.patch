diff --git a/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/add-multiple-new-fields.c b/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/add-multiple-new-fields.c
new file mode 100644
index 000000000000..e4b970b8b5c0
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/add-multiple-new-fields.c
@@ -0,0 +1,36 @@
+/* Add new_field to crypto_tfm */
+struct crypto_tfm {
+	char refcnt[4];
+
+	int crt_flags;
+
+	int new_field;
+
+	int new_field1;
+
+	int node;
+
+	void (*exit)(struct crypto_tfm *tfm);
+
+	void *__crt_alg;
+
+	void *__crt_ctx[] __attribute__((__aligned__(8)));
+};
+
+/* Add new field to ecdh, allowing some space for padding */
+struct ecdh {
+	char new_field[3];
+
+	char *key;
+	unsigned short key_size;
+
+	char new_flexible_array[];
+};
+
+int main()
+{
+	struct crypto_tfm tfm;
+	struct ecdh ecdh;
+
+	return 0;
+}
diff --git a/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/add-multiple-new-fields.expected b/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/add-multiple-new-fields.expected

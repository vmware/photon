+static void get_typedef_name(struct tag *tag, struct cu *cu,
+				char *buf, int buf_len) {
+	struct tag *base;
+	char typedef_name[32];
+
+	if(!tag__is_typedef(tag))
+		return;
+
+	tag__name(tag, cu, typedef_name, sizeof(typedef_name), &conf);
+	base = tag__follow_typedef(tag, cu);
+	tag__name(base, cu, buf, buf_len, &conf);
+
+	/* Typedef of struct may not have another name, ex) be128 */
+	if(tag__is_struct(base) && !strcmp(buf, "struct ")) {
+		snprintf(buf, buf_len - 1, "struct %s", typedef_name);
+		return;
+	}
+
+	strncpy(buf, typedef_name, buf_len);
+}
+
+static void print_array_dimensions(const struct array_type *at,
+					char *array_dims, int len) {
+	int i;
+	char dims[16];
+
+	for(i = 0; i < at->dimensions; ++i) {
+		if(at->nr_entries[i] == 0)
+			snprintf(dims, sizeof(dims), "%s[%d:]", array_dims,
+					at->nr_entries[i]);
+		else
+			snprintf(dims, sizeof(dims), "%s[%d]", array_dims,
+					at->nr_entries[i]);
+		strncpy(array_dims, dims, len);
+	}
+}

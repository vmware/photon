+/* Print the name of the data structure, ex) struct cipher_alg, etc. */
+void print_data_structure_type_name(tree type, char *buffer, int buf_len)
+{
+	const char* prefix = "";
+
+	if(TREE_CODE(type) == RECORD_TYPE)
+		prefix = "struct ";
+	else if(TREE_CODE(type) == UNION_TYPE)
+		prefix = "union ";
+
+	snprintf(buffer, buf_len, "%s%s", prefix, ORIG_TYPE_NAME(type));
+}
+
+/* Taken from gcc/tree-pretty-print.cc */
+static void dump_function_declaration(pretty_printer *pp, tree node, int spc,
+				      dump_flags_t flags)
+{
+	bool wrote_arg = false;
+	tree arg;
+
+	pp_left_paren(pp);
+
+	/* Print the argument types.  */
+	arg = TYPE_ARG_TYPES(node);
+	while (arg && arg != void_list_node && arg != error_mark_node) {
+		if (wrote_arg) {
+			pp_comma(pp);
+			pp_space(pp);
+		}
+		wrote_arg = true;
+		dump_generic_node(pp, TREE_VALUE(arg), spc, flags, false);
+		arg = TREE_CHAIN(arg);
+	}
+
+	/* Drop the trailing void_type_node if we had any previous argument. */
+	if (arg == void_list_node && !wrote_arg)
+		pp_string(pp, "void");
+	/* Properly dump vararg function types.  */
+	else if (!arg && wrote_arg)
+		pp_string(pp, ", ...");
+	/* Avoid printing any arg for unprototyped functions.  */
+
+	pp_right_paren(pp);
+}
+
+static char *print_func_to_str(tree type)
+{
+	tree ret_type = TREE_TYPE(TREE_TYPE(type));
+	pretty_printer pp;
+	int spc = 1;
+	dump_flags_t flags = TDF_SLIM;
+	const char *str = "";
+
+	if(TREE_CODE(type) == POINTER_TYPE)
+		str = "*";
+
+	tree fnode = TREE_TYPE(type);
+	dump_generic_node(&pp, ret_type, spc, flags, false);
+	pp_space(&pp);
+	pp_left_paren(&pp);
+	pp_right_paren(&pp);
+	dump_function_declaration(&pp, fnode, spc, flags);
+	pp_space(&pp);
+	pp_string(&pp, str);
+
+	return xstrdup(pp_formatted_text(&pp));
+}

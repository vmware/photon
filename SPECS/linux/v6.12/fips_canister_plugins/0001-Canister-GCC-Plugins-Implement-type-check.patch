+/*
+ * Returns true if type of kernel structure field matches type of canister
+ * structure field
+ */
+#define TYPE_STACK_MAX_LEN 2048
+static bool type_comparison(char *stack, int indent, tree kernel_type,
+			    struct data_member *canister_type)
+{
+	struct data_structure *canister_member_def;
+	struct data_member *member;
+	tree field;
+	char kernel_type_str[256];
+	int i = 0;
+	char *stack_append;
+	bool ret;
+	char indent_str[16] = { 0 };
+	tree attr_arg;
+	tree allowed_mismatch_attr;
+	const char *mismatch_kernel_type, *mismatch_canister_type;
+
+	canister_member_def = get_nested_structure_def(canister_type);
+
+	if (!strcmp(canister_type->name, PAD_FIELD_NAME))
+		return true;
+
+	/* If end of the chain, get the field name. Else get the data structure name. */
+	if (!canister_member_def || !TREE_TYPE(kernel_type))
+		get_field_type_str(kernel_type, kernel_type_str,
+				   sizeof(kernel_type_str));
+	else
+		print_data_structure_type_name(TREE_TYPE(kernel_type),
+					       kernel_type_str,
+					       sizeof(kernel_type_str));
+
+	/* Check if allowed type is specified first - this should match correctly */
+	allowed_mismatch_attr = lookup_attribute(CANISTER_MISMATCH_ATTR,
+							DECL_ATTRIBUTES(kernel_type));
+	if(allowed_mismatch_attr) {
+		attr_arg = TREE_VALUE(allowed_mismatch_attr);
+		mismatch_kernel_type = TREE_STRING_POINTER(TREE_VALUE(attr_arg));
+		/*
+		 * This should never be null, because we require two arguments when we register
+		 * the attribute. It will be caught earlier.
+		 */
+		attr_arg = TREE_CHAIN(attr_arg);
+		mismatch_canister_type = TREE_STRING_POINTER(TREE_VALUE(attr_arg));
+
+		/* Types should match the type specified in the attribute tag */
+		if(strcmp(kernel_type_str, mismatch_kernel_type))
+			error("Mismatch attribute:\n%s:\nKernel type doesn't match attribute "
+				"argument:\n(kernel) %s != %s (attribute specified)\n"
+				"Note: Found '__attribute__((" CANISTER_MISMATCH_ATTR
+				"('%s', '%s')));'",
+				stack, kernel_type_str, mismatch_kernel_type,
+				mismatch_kernel_type, mismatch_canister_type);
+
+
+		if(strcmp(canister_type->type_name, mismatch_canister_type))
+			error("Mismatch attribute:\n%s:\nCanister type doesn't match attribute "
+				"argument:\n(canister) %s != %s (attribute specified)\n"
+				"Note: Found '__attribute__((" CANISTER_MISMATCH_ATTR
+				"('%s', '%s')));'",
+				stack, canister_type->type_name, mismatch_canister_type,
+				mismatch_kernel_type, mismatch_canister_type);
+	}
+
+	if (strcmp(kernel_type_str, canister_type->type_name)) {
+		if (TREE_CODE(kernel_type) == FIELD_DECL)
+			kernel_type = TREE_TYPE(kernel_type);
+
+		/* Allow conversions between 'void *' and other pointers */
+		if (tree_is_void_ptr(kernel_type) && canister_type->is_ptr)
+			return true;
+		else if (canister_type_is_void_ptr(canister_type) &&
+			 TREE_CODE(kernel_type) == POINTER_TYPE)
+			return true;
+
+		/*
+		 * If we specified mismatched types, and we've validated above that they match,
+		 * don't throw any errors
+		 */
+		if(!allowed_mismatch_attr)
+			error("Type mismatch:\n%s:\n(kernel) '%s' != '%s' (canister)",
+				stack, kernel_type_str, canister_type->type_name);
+	}
+
+	/* Check if any nested members */
+	if (!canister_member_def)
+		return true;
+
+	if (canister_member_def && !TREE_TYPE(kernel_type)) {
+		error("Reference chain mismatch at %s:\nend of kernel chain, canister continues.",
+		      stack);
+		return false;
+	}
+
+	/* Check each member */
+	for (member = first_member(canister_member_def), field = TYPE_FIELDS(TREE_TYPE(kernel_type));
+		field && i < canister_member_def->nr_members;
+		field = TREE_CHAIN(field), member = &canister_member_def->members[++i]) {
+		stack_append = (char *)xcalloc(TYPE_STACK_MAX_LEN, sizeof(char));
+		if (!stack_append) {
+			error("Failed to alloc memory for type comparison stack history string: %s",
+			      xstrerror(errno));
+			return false;
+		}
+
+		if (!field || !TREE_TYPE(field))
+			get_field_type_str(field, kernel_type_str,
+				   sizeof(kernel_type_str));
+		else
+			print_data_structure_type_name(TREE_TYPE(kernel_type),
+					       	kernel_type_str,
+					       	sizeof(kernel_type_str));
+
+		memset(indent_str, '\t', indent + 1);
+		snprintf(stack_append, TYPE_STACK_MAX_LEN, "%s\n%s->(%s) %s",
+			 stack, indent_str, kernel_type_str, member->name);
+
+		ret = type_comparison(stack_append, indent + 1, field, member);
+
+		free(stack_append);
+
+		if (!ret)
+			return ret;
+	}
+
+	return true;
+}

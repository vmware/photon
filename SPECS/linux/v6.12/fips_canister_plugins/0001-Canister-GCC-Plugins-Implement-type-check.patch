+/*
+ * For entries with the same key, return the entry at the specified index
+ */
+struct hash_table_entry *hash_table_get_index(struct hash_table *htable,
+						const char *key, int key_len,
+						int offset)
+{
+	int index, start_index;
+	int offset_idx = 0;
+	struct hash_table_entry *htable_entry;
+
+	index = hash_string(key, key_len) % htable->num_entries;
+	start_index = index;
+
+	do {
+		htable_entry = &htable->entries[index];
+		if (!strcmp(key, htable_entry->key)) {
+			if(offset_idx == offset)
+				return htable_entry;
+
+			offset_idx++;
+		}
+
+		if (index >= htable->num_entries - 1)
+			index = 0;
+		else
+			index++;
+
+	} while (index != start_index);
+
+	return NULL;
+}

-static void get_base_type_name(struct class_member *cls_member, struct cu *cu,
+/* Replace multiple spaces with single space */
+static void normalize_type_name(char *type_name, int len)
+{
+	int start;
+	char tmp[len];
+
+	for(int i = 1; i < len; i++) {
+		start = 0;
+		while(isspace(type_name[i]) &&
+			isspace(type_name[i-1]) && i < len) {
+			if(!start)
+				start = i;
+			i++;
+		}
+
+		if(start) {
+			strncpy(tmp, &type_name[i], len - 1);
+			strcpy(&type_name[start], tmp);
+		}
+
+	}
+}

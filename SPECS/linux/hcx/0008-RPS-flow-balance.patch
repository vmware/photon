diff --git a/net/core/dev.c b/net/core/dev.c
index 8a9a85af1..261e3e794 100644
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -4629,6 +4629,19 @@ EXPORT_SYMBOL(__dev_direct_xmit);
  *************************************************************************/
 static DEFINE_PER_CPU(struct task_struct *, backlog_napi);
 

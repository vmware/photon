 }
 
+static inline void rps_record_sock_flow_w_cpu(
+				struct rps_sock_flow_table *table,
+				u32 hash, u8 cpu_id)
+{
+	if (table && hash) {
+		unsigned int index = hash & table->mask;
+		u32 val = hash & ~net_hotdata.rps_cpu_mask;
+
+		val |= cpu_id;
+
+		if (table->ents[index] != val)
+			table->ents[index] = val;
+	}
+}

 		void *dst_virt = kmap_local_page(dst_page) + dst->offset;
 
@@ -1296,7 +1301,7 @@ static void gcm_process_assoc(const struct aes_gcm_key *key, u8 ghash_acc[16],
 
 	while (assoclen) {
 		unsigned int len_this_page = scatterwalk_clamp(&walk, assoclen);

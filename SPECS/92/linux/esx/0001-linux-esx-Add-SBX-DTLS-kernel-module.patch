+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NON-INFRINGEMENT. IN NO EVENT SHALL
+ * THE COPYRIGHT HOLDERS, AUTHORS AND/OR ITS SUPPLIERS BE LIABLE FOR ANY CLAIM,
+ * DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR
+ * OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE
+ * USE OR OTHER DEALINGS IN THE SOFTWARE.
+ */
+/*
+ * sbx_dtls_reg.h --
+ * Register definitions for the SBX DTLS device.
+ */
+
+ #ifndef _SBX_DTLS_REG_H_
+ #define _SBX_DTLS_REG_H_
+
+/*
+ * SBX_DTLS_CONNECTION_ID -
+ * Written by the kernel driver, to set the connection context in the SBX code.
+ */
+#define SBX_DTLS_REG_CONNECTION_ID        0
+
+/*
+ * SBX_DTLS_CONNECTION_CHUNK -
+ * Written by the SBX code, read by the kernel driver. This has the starting
+ * chunk number for the connection in the context.
+ */
+#define SBX_DTLS_REG_CONNECTION_CHUNK     1
+
+/*
+ * SBX_DTLS_CONNECTION_MPNS
+ * Written by the SBX code, read by the kernel driver. This has the number of
+ * MPNs setup for this connection.
+ */
+#define SBX_DTLS_REG_CONNECTION_MPNS      2
+
+/*
+ * SBX_DTLS_REG_VERSION
+ * SBX version
+ */
+#define SBX_DTLS_REG_VERSION              3
+
+/*
+ * SBX_DTLS_REG_CLEAR_CONNECTION
+ * Set by the userspace to indicate the SBX code to cleanup a connection
+ */
+#define SBX_DTLS_REG_CLEAR_CONNECTION     4
+
+/*
+ * SBX_DTLS_REG_ACCEPT_CONNECTIONS
+ * Set by the userspace to indicate to the SBX device to accept workload
+ * connections.
+ */
+#define SBX_DTLS_REG_ACCEPT_CONNECTIONS   5
+
+/*
+ * SBX_DTLS_REG_CONNECTION_UUID_LOW8
+ * Written by the SBX code, read by the kernel driver. This has the low 8 bytes
+ * of the VM UUID for the connection in the context.
+ */
+#define SBX_DTLS_REG_CONNECTION_UUID_LOW8  6
+
+/*
+ * SBX_DTLS_REG_CONNECTION_UUID_HIGH8
+ * Written by the SBX code, read by the kernel driver. This has the high 8 bytes
+ * of the VM UUID for the connection in the context.
+ */
+#define SBX_DTLS_REG_CONNECTION_UUID_HIGH8 7
+ 
+#define SBX_DTLS_REGISTERS_MAX            32
+/*
+ * SBX_DTLS_CONNECTION_MAP_SIZE
+ * The size of the connection bitmap. This space is sufficient to maintain
+ * 2048 connections.
+ * 256 Bytes
+ */
+#define SBX_DTLS_CONNECTION_MAP_SIZE   256
+
+#define SBX_DTLS_CONNECTION_MAP_WORDS  (SBX_DTLS_CONNECTION_MAP_SIZE / 8)
+
+
+/*
+ * SBX_DTLS_DBG_CTRS_COUNT
+ * A set of counters for debuggability
+ */
+#define SBX_DTLS_DBG_CTRS_COUNT        64
+
+/*
+ * SBX_DTLS_CMD_BAR_LEN
+ * Size of the command BAR length. Needs to be a power of 2.
+ */
+#define SBX_DTLS_CMD_BAR_LEN           32768
+
+/*
+ * Command BAR Memory Layout:
+ *
+ *  Offset Range (end exclusive)   Region
+ *  +-------------------+---------------------------+
+ *  | [0x000 - 0x100)   | Command Registers (32x8B) |
+ *  +-------------------+---------------------------+
+ *  | [0x100 - 0x300)   | Debug Counters (64x8B)    |
+ *  +-------------------+---------------------------+
+ *  | [0x300 - 0x400)   | Connection Map (256B)     |
+ *  +-------------------+---------------------------+
+ *  | [0x400 - 0x8000)  | Reserved                  |
+ *  +-------------------+---------------------------+
+ */
+
+/* Command Registers: offset 0x000 - 0x100 (exclusive) */
+#define SBX_DTLS_OFFSET_CMD_REGS       0
+#define SBX_DTLS_OFFSET_CMD_REGS_END   (SBX_DTLS_REGISTERS_MAX * 8)
+
+/* Debug Counters: offset 0x100 - 0x300 (exclusive) */
+#define SBX_DTLS_OFFSET_DBG_CTRS       SBX_DTLS_OFFSET_CMD_REGS_END
+#define SBX_DTLS_OFFSET_DBG_CTRS_END   (SBX_DTLS_OFFSET_DBG_CTRS + SBX_DTLS_DBG_CTRS_COUNT * 8)
+
+/* Connection Map: offset 0x300 - 0x400 (exclusive) */
+#define SBX_DTLS_OFFSET_CONNECTION_MAP SBX_DTLS_OFFSET_DBG_CTRS_END
+#define SBX_DTLS_OFFSET_CONNECTION_MAP_END (SBX_DTLS_OFFSET_CONNECTION_MAP + SBX_DTLS_CONNECTION_MAP_SIZE)
+
+/* Offset range check macros */
+#define OFFSET_IS_CMD_REG(offset) \
+   ((offset) >= SBX_DTLS_OFFSET_CMD_REGS && (offset) < SBX_DTLS_OFFSET_CMD_REGS_END)
+
+#define OFFSET_IS_DBG_CTR(offset) \
+   ((offset) >= SBX_DTLS_OFFSET_DBG_CTRS && (offset) < SBX_DTLS_OFFSET_DBG_CTRS_END)
+
+#define OFFSET_IS_CONNECTION_MAP(offset) \
+	(offset >= SBX_DTLS_OFFSET_CONNECTION_MAP && offset < SBX_DTLS_OFFSET_CONNECTION_MAP_END)
+
+#endif

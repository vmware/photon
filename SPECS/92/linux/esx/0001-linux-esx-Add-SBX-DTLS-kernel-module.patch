+
+#define UUID_LEN 16
+
+typedef unsigned long long sbx_connection_map_t[SBX_DTLS_CONNECTION_MAP_WORDS];
+typedef unsigned long long sbx_dbg_ctrs_t[SBX_DTLS_DBG_CTRS_COUNT];
+
+/* SBX Connection Info message */
+typedef struct sbx_connection_info_msg {
+	unsigned long connection_id;
+	unsigned long connection_chunk;
+	unsigned long connection_mpns;
+	unsigned char workload_vm_uuid[UUID_LEN];
+} sbx_connection_info_msg_t;
+
+/* Connection map response message */
+typedef struct sbx_connection_map_msg {
+	sbx_connection_map_t connection_map;
+} sbx_connection_map_msg_t;
+
+/* Debug counters response message */
+typedef struct sbx_dbg_ctrs_msg {
+	sbx_dbg_ctrs_t dbg_ctrs;
+} sbx_dbg_ctrs_msg_t;
+
+/* Clear connection message */
+typedef struct sbx_connection_clear_msg {
+	unsigned long connection_id;
+} sbx_connection_clear_msg_t;
+
+/* Accept connections message */
+typedef struct sbx_accept_connections_msg {
+	unsigned int accept;
+} sbx_accept_connections_msg_t;

+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/kernel.h>
+#include <linux/version.h>
+#include <linux/spinlock.h>
+#include <linux/slab.h>
+#include <linux/fs.h>
+#include <linux/errno.h>
+#include <linux/types.h>
+#include <linux/fcntl.h>
+#include <linux/cdev.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/stat.h>
+#include <linux/poll.h>
+#include <linux/pci_ids.h>
+#include "sbx_dtls_reg.h"
+#include "sbx_dtls_ioctl.h"
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Broadcom, Inc.");
+MODULE_DESCRIPTION("SBX DTLS driver");
+
+#define SBX_DEVICE_VERSION          1
+
+#define SBX_NAME "sbxdtls"
+#define SBX_MINOR 0
+
+#define SBX_CMD_BAR     0
+#define SBX_SHM_BAR     2
+
+struct sbx_dev {
+	struct cdev sbx_cdev;
+	dev_t devno;
+	struct class *class;
+	char *cmd_remap;
+	char *cmd_dbg_ctrs_addr;
+	char *cmd_connection_map_addr;
+	char *shm_remap;
+	unsigned int irq;
+	resource_size_t shm_addr;
+	wait_queue_head_t launch_waitq;
+	atomic_t launch_ready;
+
+	bool avail;
+	/* This spinlock locks the sbx device. */
+	spinlock_t lock;
+};
+
+static struct sbx_dev *sbx_device;
+
+static unsigned long long sbx_read_reg(unsigned long reg)
+{
+	char *addr;
+
+	addr = sbx_device->cmd_remap;
+	return readq(addr + (reg * 8));
+}
+
+static void sbx_write_reg(unsigned long reg, unsigned long long value)
+{
+	char *addr;
+
+	addr = sbx_device->cmd_remap;
+	writeq(value, addr + (reg * 8));
+}
+
+static int sbx_open(struct inode *inode, struct file *filp)
+{
+	int result;
+
+	spin_lock(&sbx_device->lock);
+
+	if (!sbx_device->avail) {
+		result = -EBUSY;
+		spin_unlock(&sbx_device->lock);
+		pr_err("sbx open: pid %i (%s) busy fail\n",
+		       current->pid, current->comm);
+		return result;
+	}
+
+	sbx_device->avail = false;
+	spin_unlock(&sbx_device->lock);
+
+	pr_debug("sbx open: pid %i (%s)\n", current->pid, current->comm);
+
+	return 0;
+}
+
+static int sbx_release(struct inode *inode, struct file *filp)
+{
+	spin_lock(&sbx_device->lock);
+
+	WARN_ON(sbx_device->avail);
+
+	sbx_device->avail = true;
+	spin_unlock(&sbx_device->lock);
+
+	pr_debug("sbx release: pid %i (%s)\n", current->pid, current->comm);
+
+	return 0;
+}
+
+static int sbx_ioctl_connection_info(unsigned long arg)
+{
+	sbx_connection_info_msg_t msg;
+	u64 connection_chunk;
+	u64 connection_mpns;
+	u64 connection_uuid_low8;
+	u64 connection_uuid_high8;
+
+	if (copy_from_user(&msg, (void *)arg, sizeof(msg)) != 0) {
+		pr_err("sbx connection info ioctl: failed to copy msg\n");
+		return -EFAULT;
+	}
+
+	pr_debug("sbx get connection info: connection_id=%lu\n", msg.connection_id);
+
+	spin_lock(&sbx_device->lock);
+	/* Write the connection ID to the connection register */
+	sbx_write_reg(SBX_DTLS_REG_CONNECTION_ID, msg.connection_id);
+	/* Read the data from the chunk and MPNs registers */
+	connection_chunk = sbx_read_reg(SBX_DTLS_REG_CONNECTION_CHUNK);
+	connection_mpns = sbx_read_reg(SBX_DTLS_REG_CONNECTION_MPNS);
+	connection_uuid_low8 = sbx_read_reg(SBX_DTLS_REG_CONNECTION_UUID_LOW8);
+	connection_uuid_high8 = sbx_read_reg(SBX_DTLS_REG_CONNECTION_UUID_HIGH8);
+	spin_unlock(&sbx_device->lock);
+
+	/* Pack the two 64-bit register reads into the 16-byte UUID byte array.
+	 * Low 8 bytes occupy uuid[0..7], high 8 bytes occupy uuid[8..15], matching
+	 * the layout: low8 == *(u64 *)uuid, high8 == *(u64 *)(uuid + 8).
+	 */
+	memcpy(&msg.workload_vm_uuid[0], &connection_uuid_low8, sizeof(connection_uuid_low8));
+	memcpy(&msg.workload_vm_uuid[8], &connection_uuid_high8, sizeof(connection_uuid_high8));
+
+	pr_debug("sbx get connection info: connection_chunk=%llu connection_mpns=%llu workload_vm_uuid=%*phN\n",
+		connection_chunk, connection_mpns, UUID_LEN, msg.workload_vm_uuid);
+
+	msg.connection_chunk = connection_chunk;
+	msg.connection_mpns = connection_mpns;
+
+	if (copy_to_user((void *)arg, &msg, sizeof(msg)) != 0) {
+		pr_err("sbx connection info ioctl: failed to copy msg back to user\n");
+		return -EFAULT;
+	}
+
+	return 0;
+}
+
+static int sbx_ioctl_connection_map(unsigned long arg)
+{
+	sbx_connection_map_t connection_map;
+	char __user *user_ptr;
+
+	spin_lock(&sbx_device->lock);
+	/* Read from mapped connection map space */
+	memcpy_fromio(&connection_map, sbx_device->cmd_connection_map_addr,
+		      sizeof(connection_map));
+	spin_unlock(&sbx_device->lock);
+
+	/* Calculate the address of the connection_map field in the user structure */
+	user_ptr = (char __user *)arg +
+		   offsetof(sbx_connection_map_msg_t, connection_map);
+
+	/* Copy the connection map to the connection_map field in user structure */
+	if (copy_to_user(user_ptr, &connection_map, sizeof(connection_map)) != 0) {
+		pr_err("sbx connection map ioctl: failed to copy connection map back to user\n");
+		return -EFAULT;
+	}
+
+	return 0;
+}
+
+static int sbx_ioctl_dbg_ctrs(unsigned long arg)
+{
+	sbx_dbg_ctrs_t dbg_ctrs;
+	char __user *user_ptr;
+
+	spin_lock(&sbx_device->lock);
+	/* Read from mapped debug counters space */
+	memcpy_fromio(&dbg_ctrs, sbx_device->cmd_dbg_ctrs_addr, sizeof(dbg_ctrs));
+	spin_unlock(&sbx_device->lock);
+
+	/* Calculate the address of the dbg_ctrs field in the user structure */
+	user_ptr = (char __user *)arg + offsetof(sbx_dbg_ctrs_msg_t, dbg_ctrs);
+
+	/* Copy the debug counters to the dbg_ctrs field in the user structure */
+	if (copy_to_user(user_ptr, &dbg_ctrs, sizeof(dbg_ctrs)) != 0) {
+		pr_err("sbx dbg ctrs ioctl: failed to copy debug counters back to user\n");
+		return -EFAULT;
+	}
+
+	return 0;
+}
+
+static int sbx_ioctl_clear_connection(unsigned long arg)
+{
+	sbx_connection_clear_msg_t msg;
+
+	if (copy_from_user(&msg, (void *)arg, sizeof(msg)) != 0) {
+		pr_err("sbx clear connection ioctl: failed to copy msg\n");
+		return -EFAULT;
+	}
+
+	pr_debug("sbx clear connection: connection_id=%lu\n", msg.connection_id);
+
+	spin_lock(&sbx_device->lock);
+	/* Write the connection ID to the clear connection register */
+	sbx_write_reg(SBX_DTLS_REG_CLEAR_CONNECTION, msg.connection_id);
+	spin_unlock(&sbx_device->lock);
+
+	return 0;
+}
+
+static int sbx_ioctl_accept_connections(unsigned long arg)
+{
+	sbx_accept_connections_msg_t msg;
+
+	if (copy_from_user(&msg, (void *)arg, sizeof(msg)) != 0) {
+		pr_err("sbx accept connections ioctl: failed to copy msg\n");
+		return -EFAULT;
+	}
+
+	/* Ensure the value is only 0 or 1 */
+	if (msg.accept > 1) {
+		pr_err("sbx accept connections ioctl: invalid value %u (must be 0 or 1)\n",
+		       msg.accept);
+		return -EINVAL;
+	}
+
+	pr_debug("sbx accept connections: %s\n",
+		msg.accept ? "enabled" : "disabled");
+
+	spin_lock(&sbx_device->lock);
+	/* Write the accept connections value to the register */
+	sbx_write_reg(SBX_DTLS_REG_ACCEPT_CONNECTIONS, msg.accept);
+	spin_unlock(&sbx_device->lock);
+
+	return 0;
+}
+
+static long sbx_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	switch (cmd) {
+	case SBX_DTLS_IOCTL_CONNECTION_INFO:
+		return sbx_ioctl_connection_info(arg);
+	case SBX_DTLS_IOCTL_CONNECTION_MAP:
+		return sbx_ioctl_connection_map(arg);
+	case SBX_DTLS_IOCTL_CLEAR_CONNECTION:
+		return sbx_ioctl_clear_connection(arg);
+	case SBX_DTLS_IOCTL_ACCEPT_CONNECTIONS:
+		return sbx_ioctl_accept_connections(arg);
+	case SBX_DTLS_IOCTL_FETCH_DEBUG_CTRS:
+		return sbx_ioctl_dbg_ctrs(arg);
+	default:
+		pr_err("sbx ioctl: pid %i (%s) invalid cmd(%u)\n",
+		       current->pid, current->comm, cmd);
+		return -EINVAL;
+	}
+}
+
+static int sbx_mmap(struct file *filp, struct vm_area_struct *vma)
+{
+	unsigned long len = vma->vm_end - vma->vm_start;
+	unsigned long pfn = (sbx_device->shm_addr >> PAGE_SHIFT) + vma->vm_pgoff;
+
+	if (remap_pfn_range(vma, vma->vm_start, pfn, len, vma->vm_page_prot)) {
+		pr_err("sbx mmap: remap_pfn_range fail\n");
+		return -EAGAIN;
+	}
+
+	pr_debug("sbx mmap: pid %i (%s)\n", current->pid, current->comm);
+
+	return 0;
+}
+
+static irqreturn_t sbx_irq_handler(int irq, void *dev_id)
+{
+	struct sbx_dev *sbx = (struct sbx_dev *)dev_id;
+
+	atomic_inc(&sbx->launch_ready);
+	wake_up_interruptible(&sbx->launch_waitq);
+
+	return IRQ_HANDLED;
+}
+
+static __poll_t sbx_poll(struct file *filp, struct poll_table_struct *wait)
+{
+	__poll_t mask = 0;
+	int pending;
+
+	poll_wait(filp, &sbx_device->launch_waitq, wait);
+
+	pending = atomic_xchg(&sbx_device->launch_ready, 0);
+	pr_debug("sbx poll: launch_ready=%d\n", pending);
+
+	if (pending > 0)
+		mask |= POLLIN;
+
+	return mask;
+}
+
+static const struct file_operations sbx_fops = {
+	.owner =          THIS_MODULE,
+	.open =           sbx_open,
+	.mmap =           sbx_mmap,
+	.release =        sbx_release,
+	.unlocked_ioctl = sbx_ioctl,
+	.poll =           sbx_poll,
+};
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+static char *sbx_devnode(const struct device *dev, umode_t *mode)
+#else
+static char *sbx_devnode(struct device *dev, umode_t *mode)
+#endif
+{
+	if (mode)
+		*mode = 0600;
+	return NULL;
+}
+
+static int sbx_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	int irq;
+	int result;
+	char *addr;
+	dev_t devno_sbx;
+	unsigned long flags;
+	unsigned int dword = 0;
+	const unsigned int BUS_MASTER = 0x4;
+	const unsigned int CMD_REG_OFFSET = 4;
+	resource_size_t cmd_addr;
+	resource_size_t cmd_len;
+	unsigned long cmd_flags;
+	resource_size_t shm_len;
+	unsigned long shm_flags;
+	struct device *d;
+
+	if (sbx_device) {
+		pr_err("sbx: unexpected probe\n");
+		return -EPERM;
+	}
+
+	pci_read_config_dword(pdev, CMD_REG_OFFSET, &dword);
+	if (!(dword & BUS_MASTER)) {
+		pci_write_config_dword(pdev, CMD_REG_OFFSET, dword | BUS_MASTER);
+		pci_read_config_dword(pdev, CMD_REG_OFFSET, &dword);
+		if (dword & BUS_MASTER) {
+			pr_debug("sbx probe: bus master enabled\n");
+		} else {
+			pr_err("sbx probe: bus master enable fail\n");
+			return -EPERM;
+		}
+	}
+
+	result = alloc_chrdev_region(&devno_sbx, SBX_MINOR, 1, SBX_NAME);
+	if (result != 0) {
+		pr_err("sbx probe: alloc major number with minor %d fail error=%d\n",
+		       SBX_MINOR, result);
+		return result;
+	}
+
+	sbx_device = kzalloc(sizeof(*sbx_device), GFP_KERNEL);
+	if (!sbx_device) {
+		result = -ENOMEM;
+		pr_err("sbx probe: kzalloc fail error=%d\n", result);
+		goto fail_kzalloc_sbx;
+	}
+	spin_lock_init(&sbx_device->lock);
+	sbx_device->devno = devno_sbx;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
+	sbx_device->class = class_create(SBX_NAME "drv");
+#else
+	sbx_device->class = class_create(THIS_MODULE, SBX_NAME "drv");
+#endif
+	if (IS_ERR(sbx_device->class)) {
+		result = PTR_ERR(sbx_device->class);
+		pr_err("sbx probe: class create fail error=%d\n", result);
+		goto fail_class_create;
+	}
+
+	sbx_device->class->devnode = sbx_devnode;
+	d = device_create(sbx_device->class, NULL, devno_sbx,
+			  NULL, SBX_NAME "0");
+	if (IS_ERR(d)) {
+		result = PTR_ERR(d);
+		pr_err("sbx probe: sbx device create fail error=%d\n", result);
+		goto fail_device_create_sbx;
+	}
+
+	cdev_init(&sbx_device->sbx_cdev, &sbx_fops);
+	sbx_device->sbx_cdev.owner = THIS_MODULE;
+	result = cdev_add(&sbx_device->sbx_cdev, devno_sbx, 1);
+	if (result != 0) {
+		pr_err("sbx probe: add sbx fail error=%d\n", result);
+		goto fail_cdev_add_sbx;
+	}
+
+	result = pci_enable_device(pdev);
+	if (result != 0) {
+		pr_err("sbx probe: pci enable device fail error=%d\n", result);
+		goto fail_pci_enable_device;
+	}
+
+	result = pci_request_region(pdev, SBX_CMD_BAR, "sbx-cmd-bar");
+	if (result != 0) {
+		pr_err("sbx probe: cmd bar request fail error=%d\n", result);
+		goto fail_pci_request_region_cmd;
+	}
+	cmd_addr = pci_resource_start(pdev, SBX_CMD_BAR);
+	cmd_len = pci_resource_len(pdev, SBX_CMD_BAR);
+	cmd_flags = pci_resource_flags(pdev, SBX_CMD_BAR);
+	pr_debug("sbx probe: cmd bar start=%pa len=%pa flags=%#lx\n",
+		&cmd_addr, &cmd_len, cmd_flags);
+	flags = IORESOURCE_MEM;
+	if ((cmd_flags & flags) != flags) {
+		pr_err("sbx probe: cmd bar flags must be %#lx fail\n", flags);
+		result = -EINVAL;
+		goto fail_pci_request_region_cmd_resource;
+	}
+
+	result = pci_request_region(pdev, SBX_SHM_BAR, "sbx-shm-bar");
+	if (result != 0) {
+		pr_err("sbx probe: shm bar request fail error=%d\n", result);
+		goto fail_pci_request_region_cmd_resource;
+	}
+	sbx_device->shm_addr = pci_resource_start(pdev, SBX_SHM_BAR);
+	shm_len = pci_resource_len(pdev, SBX_SHM_BAR);
+	shm_flags = pci_resource_flags(pdev, SBX_SHM_BAR);
+	pr_debug("sbx probe: shm bar start=%pa len=%pa flags=%#lx\n",
+		&sbx_device->shm_addr, &shm_len, shm_flags);
+	flags = IORESOURCE_MEM | IORESOURCE_PREFETCH;
+	if ((shm_flags & flags) != flags) {
+		pr_err("sbx probe: shm bar flags must be %#lx fail\n", flags);
+		result = -EINVAL;
+		goto fail_pci_request_region_shm_resource;
+	}
+
+	result = pci_alloc_irq_vectors(pdev, 1, 1, PCI_IRQ_MSI);
+	if (result < 1) {
+		pr_err("sbx probe: pci alloc irq vectors fail error=%d\n",
+		       result);
+		goto fail_pci_request_region_shm_resource;
+	}
+
+	init_waitqueue_head(&sbx_device->launch_waitq);
+	irq = pci_irq_vector(pdev, 0);
+	result = request_irq(irq, sbx_irq_handler, 0, SBX_NAME, sbx_device);
+	if (result != 0) {
+		pr_err("sbx probe: request irq fail irq=%d error=%d\n",
+		       irq, result);
+		goto fail_request_irq;
+	}
+	sbx_device->irq = irq;
+
+	sbx_device->cmd_remap = ioremap(cmd_addr, cmd_len);
+	if (!sbx_device->cmd_remap) {
+		pr_err("sbx probe: ioremap cmd bar fail\n");
+		result = -ENOMEM;
+		goto fail_ioremap_cmd;
+	}
+
+	sbx_device->shm_remap = ioremap(sbx_device->shm_addr, shm_len);
+	if (!sbx_device->shm_remap) {
+		pr_err("sbx probe: ioremap shm bar fail\n");
+		result = -ENOMEM;
+		goto fail_ioremap_shm;
+	}
+
+	addr = sbx_device->cmd_remap;
+	sbx_device->cmd_dbg_ctrs_addr = addr + SBX_DTLS_OFFSET_DBG_CTRS;
+	sbx_device->cmd_connection_map_addr =
+		addr + SBX_DTLS_OFFSET_CONNECTION_MAP;
+
+	sbx_device->avail = true;
+
+	sbx_write_reg(SBX_DTLS_REG_VERSION, SBX_DEVICE_VERSION);
+	if (sbx_read_reg(SBX_DTLS_REG_VERSION) != SBX_DEVICE_VERSION) {
+		pr_err("sbx probe: version check failed\n");
+		result = -EINVAL;
+		goto fail_version_check;
+	}
+
+	return 0;
+
+fail_version_check:
+	iounmap(sbx_device->shm_remap);
+
+fail_ioremap_shm:
+	iounmap(sbx_device->cmd_remap);
+
+fail_ioremap_cmd:
+	free_irq(sbx_device->irq, sbx_device);
+
+fail_request_irq:
+	pci_free_irq_vectors(pdev);
+
+fail_pci_request_region_shm_resource:
+	pci_release_region(pdev, SBX_SHM_BAR);
+
+fail_pci_request_region_cmd_resource:
+	pci_release_region(pdev, SBX_CMD_BAR);
+
+fail_pci_request_region_cmd:
+	pci_disable_device(pdev);
+
+fail_pci_enable_device:
+	cdev_del(&sbx_device->sbx_cdev);
+
+fail_cdev_add_sbx:
+	device_destroy(sbx_device->class, sbx_device->devno);
+
+fail_device_create_sbx:
+	class_destroy(sbx_device->class);
+
+fail_class_create:
+	kfree(sbx_device);
+	sbx_device = NULL;
+
+fail_kzalloc_sbx:
+	unregister_chrdev_region(devno_sbx, 1);
+
+	return result;
+}
+
+static void sbx_remove(struct pci_dev *pdev)
+{
+	if (sbx_device) {
+		iounmap(sbx_device->cmd_remap);
+		iounmap(sbx_device->shm_remap);
+		free_irq(sbx_device->irq, sbx_device);
+		pci_free_irq_vectors(pdev);
+		pci_release_region(pdev, SBX_SHM_BAR);
+		pci_release_region(pdev, SBX_CMD_BAR);
+		pci_disable_device(pdev);
+		cdev_del(&sbx_device->sbx_cdev);
+		device_destroy(sbx_device->class, sbx_device->devno);
+		class_destroy(sbx_device->class);
+		unregister_chrdev_region(sbx_device->devno, 1);
+		kfree(sbx_device);
+		sbx_device = NULL;
+	}
+}
+
+static struct pci_device_id sbx_ids[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_VMWARE, 0x420), },
+	{ 0, }
+};
+
+static struct pci_driver sbx_driver = {
+	.name     = SBX_NAME,
+	.probe    = sbx_probe,
+	.remove   = sbx_remove,
+	.id_table = sbx_ids,
+};
+
+MODULE_DEVICE_TABLE(pci, sbx_ids);
+
+static int __init sbx_init_module(void)
+{
+	int ret = pci_register_driver(&sbx_driver);
+
+	if (ret < 0) {
+		pr_err("sbx init module: pci_register_driver fail\n");
+		return ret;
+	}
+
+	if (!sbx_device) {
+		pr_err("sbx init module: sbx_probe fail\n");
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static void __exit sbx_exit_module(void)
+{
+	pci_unregister_driver(&sbx_driver);
+}
+
+module_init(sbx_init_module);
+module_exit(sbx_exit_module);

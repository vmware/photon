+#define SBX_DTLS_IOCTL_ACCEPT_CONNECTIONS \
+	_IOW(SBX_DTLS_MAGIC, 23, struct sbx_accept_connections_msg)
+#define SBX_DTLS_IOCTL_FETCH_DEBUG_CTRS \
+	_IOR(SBX_DTLS_MAGIC, 24, struct sbx_dbg_ctrs_msg)
+
+#endif
diff --git a/drivers/misc/vmw_sbx_dtls/sbx_dtls_reg.h b/drivers/misc/vmw_sbx_dtls/sbx_dtls_reg.h

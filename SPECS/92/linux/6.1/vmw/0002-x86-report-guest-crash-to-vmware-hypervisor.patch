From 2a0137d01eec3772a29360c08c61686ab9933600 Mon Sep 17 00:00:00 2001
From: Brennan Lamoreaux <brennan.lamoreaux@broadcom.com>
Date: Sat, 1 Mar 2025 00:36:22 +0000
Subject: [PATCH] x86: report guest crash to vmware hypervisor

Register the guest crash reporter to panic_notifier_list,
which will be called at panic time. Guest crash reporter
will report the crash to the hypervisor through
a hypercall.

Signed-off-by: Brennan Lamoreaux <brennan.lamoreaux@broadcom.com>
---
 arch/x86/kernel/cpu/vmware.c | 41 ++++++++++++++++++++++++++++++------
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/arch/x86/kernel/cpu/vmware.c b/arch/x86/kernel/cpu/vmware.c
index 43c6ca65d..eb9ce3e99 100644
--- a/arch/x86/kernel/cpu/vmware.c
+++ b/arch/x86/kernel/cpu/vmware.c
@@ -31,6 +31,7 @@
 #include <linux/static_call.h>
 #include <linux/kmsg_dump.h>
 #include <linux/objtool.h>
+#include <linux/panic_notifier.h>
 #include <asm/div64.h>
 #include <asm/x86_init.h>
 #include <asm/hypervisor.h>
@@ -46,13 +47,14 @@

 #define VMWARE_HYPERVISOR_MAGIC	0x564D5868

-#define VMWARE_CMD_GETVERSION    10
-#define VMWARE_CMD_GETHZ         45
-#define VMWARE_CMD_GETVCPU_INFO  68
-#define VMWARE_CMD_LEGACY_X2APIC  3
-#define VMWARE_CMD_MESSAGE       30
-#define VMWARE_CMD_VCPU_RESERVED 31
-#define VMWARE_CMD_STEALCLOCK    91
+#define VMWARE_CMD_GETVERSION           10
+#define VMWARE_CMD_GETHZ                45
+#define VMWARE_CMD_GETVCPU_INFO         68
+#define VMWARE_CMD_LEGACY_X2APIC        3
+#define VMWARE_CMD_MESSAGE              30
+#define VMWARE_CMD_VCPU_RESERVED        31
+#define VMWARE_CMD_STEALCLOCK           91
+#define VMWARE_CMD_REPORTGUESTCRASH     102

 #define STEALCLOCK_NOT_AVAILABLE (-1)
 #define STEALCLOCK_DISABLED        0
@@ -193,6 +195,11 @@ static int vmware_cmd_stealclock(uint32_t arg1, uint32_t arg2)
 	return result;
 }

+static void vmware_cmd_report_guest_crash(void) {
+	uint32_t eax, ebx, ecx, edx;
+	VMWARE_CMD(REPORTGUESTCRASH, eax, ebx, ecx, edx);
+}
+
 static bool stealclock_enable(phys_addr_t pa)
 {
 	return vmware_cmd_stealclock(upper_32_bits(pa),
@@ -395,6 +402,24 @@ static void __init vmware_paravirt_ops_setup(void)
 #define vmware_paravirt_ops_setup() do {} while (0)
 #endif

+static int vmware_report_guest_crash(struct notifier_block *self,
+				     unsigned long action, void *data)
+{
+	vmware_cmd_report_guest_crash();
+	return 0;
+}
+
+static struct notifier_block guest_crash_reporter = {
+	.notifier_call = vmware_report_guest_crash
+};
+
+static int __init register_guest_crash_reporter(void)
+{
+	atomic_notifier_chain_register(&panic_notifier_list,
+					&guest_crash_reporter);
+
+	return 0;
+}
 /*
  * VMware hypervisor takes care of exporting a reliable TSC to the guest.
  * Still, due to timing difference when running on virtual cpus, the TSC can
@@ -467,6 +492,8 @@ static void __init vmware_platform_setup(void)
 	vmware_set_capabilities();

 	kmsg_dump_register(&kmsg_dumper);
+
+	register_guest_crash_reporter();
 }

 static u8 __init vmware_select_hypercall(void)
--
2.40.4


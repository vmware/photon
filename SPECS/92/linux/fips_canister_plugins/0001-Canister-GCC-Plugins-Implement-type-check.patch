+			return -1;
+		}
+
+		entry->ptr = def;
+		list_add_tail(&entry->l_entry, &stack_head);
+
+		heap_sz += def->__sz;
+		ret = __calc_nested_member_size(def, &stack_head);
+		if(ret < 0)
+			break;
+		heap_sz += ret;
+	}

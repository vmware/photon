+/* Return true if equal */
+static bool __data_struct_eq(struct ds_iter *ds_iter_a, struct ds_iter *ds_iter_b);
+
+static bool data_mem_eq(struct ds_iter *ds_iter_a, struct ds_iter *ds_iter_b)
+{
+	unsigned int ret = 0;
+	struct data_structure *def_a, *def_b;
+	struct data_member *a, *b;
+
+	a = ds_iter_cur_memb(ds_iter_a);
+	b = ds_iter_cur_memb(ds_iter_b);
+
+	ret += (strcmp(a->name, b->name) != 0);
+	ret += (strcmp(a->type_name, b->type_name) != 0);
+	ret += (a->byte_size != b->byte_size);
+	ret += (a->byte_offset != b->byte_offset);
+	ret += (a->is_ptr != b->is_ptr);
+
+	def_a = ds_iter_push(ds_iter_a, false);
+	def_b = ds_iter_push(ds_iter_b, false);
+
+	if(ds_iter_is_loop(ds_iter_a) && ds_iter_is_loop(ds_iter_b))
+		return ret == 0;
+	else if(!def_a && !def_b)
+		return ret == 0;
+
+	/* Allow loops, eventually will either be unequal or both hit loop at the same time */
+	if(!def_a && ds_iter_is_loop(ds_iter_a)) {
+		ds_iter_pop(ds_iter_a);
+		ds_iter_push(ds_iter_a, true);
+	}
+
+	if(!def_b && ds_iter_is_loop(ds_iter_b)) {
+		ds_iter_pop(ds_iter_b);
+		ds_iter_push(ds_iter_b, true);
+	}
+
+	ret += !__data_struct_eq(ds_iter_a, ds_iter_b);
+
+	return ret == 0;
+}
+
+/* Return true if equal, false if not equal. */
+static bool __data_struct_eq(struct ds_iter *ds_iter_a, struct ds_iter *ds_iter_b)
+{
+	struct data_structure *a, *b;
+	unsigned int ret = 0;
+	int i = 0;
+
+
+	a = ds_iter_top(ds_iter_a);
+	b = ds_iter_top(ds_iter_b);
+
+	if (!a && !b)
+		return true;
+	else if (!a || !b)
+		return false;
+
+	ret += (strcmp(a->name, b->name) != 0);
+	ret += (a->byte_size != b->byte_size);
+	ret += (a->nr_members != b->nr_members);
+
+	if (ret)
+		return false;
+
+	while(ds_iter_next_member(ds_iter_a) && ds_iter_next_member(ds_iter_b)) {
+		if (!data_mem_eq(ds_iter_a, ds_iter_b))
+			return false;
+	}
+
+	return ret == 0;
+}

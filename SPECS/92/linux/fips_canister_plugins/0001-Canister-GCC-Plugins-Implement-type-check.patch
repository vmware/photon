+tree kern_iter_field_base_type(struct kern_iter *kern_iter)
+{
+    struct kernel_stack_entry *cur_entry;
+
+    if(list_empty(&kern_iter->stack_head))
+        return NULL;
+
+    cur_entry = list_last_entry(&kern_iter->stack_head, kernel_stack_entry, l_entry);
+    return cur_entry->member_base_type;
+}
+
+/* Check if we've hit a cycle in the type graph */
+bool kern_iter_is_loop(struct kern_iter *kern_iter)

+		if(!nested)
+			continue;
+
+		list_for_each_entry(pos, stack_head, l_entry) {
+			if(data_struct_eq(pos->ptr, nested))
+				touched = true;
+		}
+
+		if(touched)
+			continue;
+
+		entry = calloc(1, sizeof(struct stack_entry));
+		if(!entry) {
+			fprintf(stderr, "Memory allocation error\n");
+			return -1;
+		}
+
+		entry->ptr = nested;
+		list_add_tail(&entry->l_entry, stack_head);
+
+		sz += nested->__sz;
+		sz += __calc_nested_member_size(nested, stack_head);
+	}
+

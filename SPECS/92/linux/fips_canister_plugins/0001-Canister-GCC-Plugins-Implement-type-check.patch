diff --git a/scripts/gcc-plugins/fips_canister_plugins/kernel_iterator.c b/scripts/gcc-plugins/fips_canister_plugins/kernel_iterator.c
new file mode 100644
index 000000000..6c59d527e
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/kernel_iterator.c
@@ -0,0 +1,184 @@
+/*
+ * Implements an iterator for stepping through GCC representation of data structures.
+ * Iterator keeps the current state, as well as the historical stack/path. Handles loop
+ * detection, while traversing essentially a directed graph of data structures.
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+#include <stdlib.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include "kernel_iterator.h"
+#include "fips_canister_common.h"
+
+void kern_iter_init(struct kern_iter *kern_iter, tree def)
+{
+	struct kernel_stack_entry *entry;
+
+	entry = (struct kernel_stack_entry *) xcalloc(1, sizeof(struct kernel_stack_entry));
+
+	INIT_LIST_HEAD(&kern_iter->stack_head);
+
+	entry->type = TYPE_MAIN_VARIANT(def);
+	entry->member = TYPE_FIELDS(def);
+	entry->member_base_type = get_field_base_type(entry->member);
+
+	list_add_tail(&entry->l_entry, &kern_iter->stack_head);
+}
+
+void kern_iter_init_member(struct kern_iter *kern_iter, tree member)
+{
+	struct kernel_stack_entry *entry;
+
+	entry = (struct kernel_stack_entry *) xcalloc(1, sizeof(struct kernel_stack_entry));
+
+	INIT_LIST_HEAD(&kern_iter->stack_head);
+
+	entry->type = TYPE_MAIN_VARIANT(DECL_CONTEXT(member));
+	entry->member = member;
+	entry->member_base_type = get_field_base_type(member);
+
+	list_add_tail(&entry->l_entry, &kern_iter->stack_head);
+}
+
+static bool is_cycle(tree next, struct kern_iter *kern_iter)
+{
+	struct kernel_stack_entry *pos;
+
+	list_for_each_entry(pos, &kern_iter->stack_head, l_entry) {
+		if(pos->type == next)
+			return true;
+	}
+
+	return false;
+}
+
+tree kern_iter_top(struct kern_iter *kern_iter)
+{
+	if(list_empty(&kern_iter->stack_head))
+		return NULL;
+
+	return list_last_entry(&kern_iter->stack_head, kernel_stack_entry, l_entry)->type;
+}
+
+tree kern_iter_next_field(struct kern_iter *kern_iter)
+{
+	int idx = 0;
+	struct kernel_stack_entry *cur_entry;
+
+	if(list_empty(&kern_iter->stack_head))
+		return NULL;
+
+	cur_entry = list_last_entry(&kern_iter->stack_head, kernel_stack_entry, l_entry);
+	cur_entry->member = cur_entry->member ? TREE_CHAIN(cur_entry->member) : NULL;
+
+	if(!cur_entry->member)
+		return NULL;
+
+	cur_entry->member_base_type = get_field_base_type(cur_entry->member);
+
+	return cur_entry->member;
+}
+
+tree kern_iter_cur_memb(struct kern_iter *kern_iter)
+{
+	int idx = 0;
+	struct kernel_stack_entry *cur_entry;
+	tree type, member;
+
+	if(list_empty(&kern_iter->stack_head))
+		return NULL;
+
+	cur_entry = list_last_entry(&kern_iter->stack_head, kernel_stack_entry, l_entry);
+	return cur_entry->member;
+}
+
+/*
+ * If the current struct member has a definition, "step" into it by adding it to the end of the
+ * stack. Returns NULL if no definition for this member, or if member is not a struct, or if member
+ * is a struct with no fields (member of itself, for example).
+ */
+tree kern_iter_push(struct kern_iter *kern_iter, bool allow_loops)
+{
+	struct kernel_stack_entry *entry, *cur_entry;
+	tree type, memb;
+	int idx = 0;
+
+	if(list_empty(&kern_iter->stack_head))
+		return NULL;
+
+	type = kern_iter_field_base_type(kern_iter);
+	if (!type ||
+	    (TREE_CODE(type) != RECORD_TYPE && TREE_CODE(type) != UNION_TYPE) ||
+	    !TYPE_FIELDS(type))
+		type = NULL;
+
+	/* xcalloc never returns NULL */
+	entry = (struct kernel_stack_entry *) xcalloc(1, sizeof(struct kernel_stack_entry));
+
+	if(type && (!is_cycle(type, kern_iter) || allow_loops)) {
+		entry->type = type;
+		entry->member = TYPE_FIELDS(type);
+		entry->member_base_type = get_field_base_type(entry->member);
+	}
+
+	list_add_tail(&entry->l_entry, &kern_iter->stack_head);
+
+	return entry->type;
+}
+
+/* Step back to the parent definition */
+tree kern_iter_pop(struct kern_iter *kern_iter)
+{
+	struct kernel_stack_entry *cur_entry;
+
+	if(list_empty(&kern_iter->stack_head))
+		return NULL;
+
+	cur_entry = list_last_entry(&kern_iter->stack_head, kernel_stack_entry, l_entry);
+	list_del(&cur_entry->l_entry);
+	free(cur_entry);
+
+	if(list_empty(&kern_iter->stack_head))
+		return NULL;
+
+	return list_last_entry(&kern_iter->stack_head, kernel_stack_entry, l_entry)->type;
+}
+
+void kern_iter_destroy(struct kern_iter *kern_iter)
+{
+	struct kernel_stack_entry *pos, *n;
+
+	list_for_each_entry_safe(pos, n, &kern_iter->stack_head, l_entry) {
+		list_del(&pos->l_entry);
+		free(pos);
+	}
+}

diff --git a/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/follow-pointer.c b/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/follow-pointer.c
new file mode 100644
index 000000000..7262763f8
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/self_tests/match_canister/follow-pointer.c
@@ -0,0 +1,74 @@
+#include "types.h"
+
+struct list_head {
+	struct list_head *next, *prev;
+};
+struct crypto_tfm;
+struct crypto_alg;
+
+struct cipher_alg {
+	/* Sneaky change - three layers down from crypto_alg, 4 layers from crypto_tfm */
+	long int cia_min_keysize;
+	unsigned int cia_max_keysize;
+	int (*cia_setkey)(struct crypto_tfm *tfm, const u8 *key,
+	                  unsigned int keylen);
+	void (*cia_encrypt)(struct crypto_tfm *tfm, u8 *dst, const u8 *src);
+	void (*cia_decrypt)(struct crypto_tfm *tfm, u8 *dst, const u8 *src);
+};
+
+struct compress_alg {
+	int (*coa_compress)(struct crypto_tfm *tfm, const u8 *src,
+			    unsigned int slen, u8 *dst, unsigned int *dlen);
+	int (*coa_decompress)(struct crypto_tfm *tfm, const u8 *src,
+			      unsigned int slen, u8 *dst, unsigned int *dlen);
+};
+
+struct crypto_tfm {
+	refcount_t refcnt;
+
+	u32 crt_flags;
+
+	int node;
+
+	void (*exit)(struct crypto_tfm *tfm);
+
+	/*
+	 * This is incomplete because crypto_alg is not yet defined, so no error here
+	 * (type name matches).
+	 */
+	struct crypto_alg *__crt_alg;
+
+	void *__crt_ctx[];
+};
+
+struct crypto_alg {
+	struct list_head cra_list;
+	struct list_head cra_users;
+
+	u32 cra_flags;
+	unsigned int cra_blocksize;
+	unsigned int cra_ctxsize;
+	unsigned int cra_alignmask;
+
+	int cra_priority;
+	refcount_t cra_refcnt;
+
+	char cra_name[128];
+	char cra_driver_name[128];
+
+	/* Convert to void * to avoid errors */
+	void *cra_type;
+
+	union {
+		struct cipher_alg cipher;
+		struct compress_alg compress;
+	} cra_u;
+
+	int (*cra_init)(struct crypto_tfm *tfm);
+	void (*cra_exit)(struct crypto_tfm *tfm);
+	void (*cra_destroy)(struct crypto_alg *alg);
+
+	void *cra_module;
+};
+
+

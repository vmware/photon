+tree get_field_base_type(tree field)
+{
+	/* Dereference FIELD_DECL */
+	field = TREE_TYPE(field);
+
+	/* Dereference pointer(s)/array(s) to get the base type */
+	while(TREE_CODE(field) == POINTER_TYPE ||
+	      TREE_CODE(field) == ARRAY_TYPE)
+		field = TREE_TYPE(field);
+
+	return TYPE_MAIN_VARIANT(field);

+static size_t __calc_nested_member_size(struct data_structure *def, struct list_head *stack_head)
+{
+	struct data_structure *nested;
+	struct data_member *member;
+	struct stack_entry *entry, *pos;
+	bool touched = false;
+	size_t sz = 0;
+
+	for_all_members(def, member)
+	{

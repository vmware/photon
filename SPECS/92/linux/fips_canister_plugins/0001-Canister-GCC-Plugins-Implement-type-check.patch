+/* Return true if equal, false if not equal. */
+bool data_struct_eq(struct data_structure *a, struct data_structure *b)
+{
+	struct ds_iter ds_iter_a, ds_iter_b;
+	bool ret;
+
+	ds_iter_init(&ds_iter_a, a);
+	ds_iter_init(&ds_iter_b, b);
+
+	ret = __data_struct_eq(&ds_iter_a, &ds_iter_b);
+
+	ds_iter_destroy(&ds_iter_a);
+	ds_iter_destroy(&ds_iter_b);
+
+	return ret;
+}

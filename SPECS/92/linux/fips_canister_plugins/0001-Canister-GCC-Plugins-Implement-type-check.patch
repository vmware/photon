+	pretty_printer pp;
+	int spc = 1;
+	dump_flags_t flags = TDF_SLIM;
+
+	dump_generic_node(&pp, ret_type, spc, flags, false);
+	pp_space(&pp);
+	pp_left_paren(&pp);
+	pp_right_paren(&pp);
+	dump_function_declaration(&pp, type, spc, flags);
+
+	return xstrdup(pp_formatted_text(&pp));

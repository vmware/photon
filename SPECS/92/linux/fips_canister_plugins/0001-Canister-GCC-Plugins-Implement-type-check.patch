index 000000000..cc860763a
--- /dev/null
+++ b/scripts/gcc-plugins/fips_canister_plugins/match_canister_structs/data_struct_iterator.c
@@ -0,0 +1,291 @@
+/*
+ * Implements iterator for stepping through debuginfo parsed data structures.
+ * The data structures are essentially a directed graph. Iterator keeps stack/path
+ * context to handle loop detection and current state.
+ *
+ * Copyright (C) 2025 Broadcom, Inc.
+ */
+
+#include <dwarves/list.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../include/xalloc.h"
+
+#include "structure_db.h"
+#include "data_struct_iterator.h"
+
+/**
+ * list_last_entry - get the last element from a list
+ * @ptr:       the list head to take the element from.
+ * @type:      the type of the struct this is embedded in.
+ * @member:    the name of the list_struct within the struct.
+ *
+ * Note, that list is expected to be not empty.
+ */
+#define list_last_entry(ptr, type, member) \
+	list_entry((ptr)->prev, type, member)
+
+struct struct_stack_entry {
+	struct data_structure *def;
+	int memb_idx;
+	struct data_member *parent_member;
+	struct list_head l_entry;
+};
+
+void ds_iter_init(struct ds_iter *ds_iter, struct data_structure *def)
+{
+	struct struct_stack_entry *entry;
+
+	entry = xcalloc(1, sizeof(struct struct_stack_entry));
+
+	INIT_LIST_HEAD(&ds_iter->stack_head);
+
+	entry->def = def;
+	entry->memb_idx = 0;
+	entry->parent_member = NULL;
+	list_add_tail(&entry->l_entry, &ds_iter->stack_head);
+}
+
+void ds_iter_init_member(struct ds_iter *ds_iter, struct data_member *memb)
+{
+	struct struct_stack_entry *entry;
+
+	entry = xcalloc(1, sizeof(struct struct_stack_entry));
+
+	INIT_LIST_HEAD(&ds_iter->stack_head);
+
+	entry->def = get_struct_def_from_member(memb);
+	entry->memb_idx = memb->__idx;
+	entry->parent_member = NULL;
+	list_add_tail(&entry->l_entry, &ds_iter->stack_head);
+}
+
+static bool is_cycle(struct data_structure *ds, struct ds_iter *ds_iter)
+{
+	struct struct_stack_entry *pos;
+
+	list_for_each_entry(pos, &ds_iter->stack_head, l_entry) {
+		if(pos->def == ds)
+			return true;
+	}
+
+	return false;
+}
+
+struct data_structure* ds_iter_top(struct ds_iter *ds_iter)
+{
+	if(list_empty(&ds_iter->stack_head))
+		return NULL;
+
+	return list_last_entry(&ds_iter->stack_head, struct struct_stack_entry, l_entry)->def;
+}
+
+struct data_member *ds_iter_next_member(struct ds_iter *ds_iter)
+{
+	int idx = 0;
+	struct data_structure *cur_def;
+	struct struct_stack_entry *cur_entry;
+	struct data_member *memb;
+
+	if(list_empty(&ds_iter->stack_head))
+		return NULL;
+
+	cur_entry = list_last_entry(&ds_iter->stack_head, struct struct_stack_entry, l_entry);
+	cur_def = cur_entry->def;
+
+	if(!cur_def)
+		return NULL;
+
+	cur_entry->memb_idx++;
+	if(cur_entry->memb_idx >= cur_def->nr_members)
+		return NULL;
+
+	return &cur_def->members[cur_entry->memb_idx];
+}
+
+struct data_member *ds_iter_cur_memb(struct ds_iter *ds_iter)
+{
+	int idx = 0;
+	struct data_structure *cur_def;
+	struct struct_stack_entry *cur_entry;
+	struct data_member *memb;
+
+	if(list_empty(&ds_iter->stack_head))
+		return NULL;
+
+	cur_entry = list_last_entry(&ds_iter->stack_head, struct struct_stack_entry, l_entry);
+	cur_def = cur_entry->def;
+
+	if(!cur_def)
+		return NULL;
+
+	if(cur_entry->memb_idx > cur_def->nr_members)
+		return NULL;
+
+	return &cur_def->members[cur_entry->memb_idx];
+}
+
+/*
+ * If the current struct member has a definition, "step" into it by adding it to the end of the
+ * stack. Returns NULL if no definition for this member.
+ */
+struct data_structure* ds_iter_push(struct ds_iter *ds_iter, bool allow_loops)
+{
+	struct struct_stack_entry *entry, *cur_entry;
+	struct data_structure *cur_def, *memb_def = NULL;
+	struct data_member *memb;
+	int idx = 0;
+
+	if(list_empty(&ds_iter->stack_head))
+		return NULL;
+
+	memb = ds_iter_cur_memb(ds_iter);
+
+	if(memb)
+		memb_def = get_nested_structure_def(memb);
+
+	/* xcalloc will never return NULL */
+	entry = xcalloc(1, sizeof(struct struct_stack_entry));
+
+	/* Step into NULL entry if cycle */
+	if(memb_def && (!is_cycle(memb_def, ds_iter) || allow_loops)) {
+		entry->def = memb_def;
+		entry->parent_member = memb;
+		entry->memb_idx = 0;
+	}
+
+	list_add_tail(&entry->l_entry, &ds_iter->stack_head);
+
+	return entry->def;
+}
+
+/* Return true if loop, false if not loop or false if the end of the chain (no more defs) */
+bool ds_iter_is_loop(struct ds_iter *ds_iter)
+{
+	struct data_member *cur_memb;
+	struct data_structure *cur_def;
+	struct struct_stack_entry *entry;
+
+	if(list_empty(&ds_iter->stack_head))
+		return false;
+
+	cur_def = ds_iter_top(ds_iter);
+	if(cur_def)
+		return false;
+
+	/* Get the last valid entry */
+	entry = list_entry(ds_iter->stack_head.prev->prev, struct struct_stack_entry, l_entry);
+	cur_def = entry->def;
+	cur_memb = &entry->def->members[entry->memb_idx];
+
+	/*
+	 * If there is a nested definition, and we started in a NULL entry,
+	 * this must be a loop
+	 */
+	if(get_nested_structure_def(cur_memb))
+		return true;
+
+	return false;
+}
+
+/* Step back to the parent definition */
+struct data_structure* ds_iter_pop(struct ds_iter *ds_iter)
+{
+	struct struct_stack_entry *cur_entry;
+
+	if(list_empty(&ds_iter->stack_head))
+		return NULL;
+
+	cur_entry = list_last_entry(&ds_iter->stack_head, struct struct_stack_entry, l_entry);
+	list_del(&cur_entry->l_entry);
+	free(cur_entry);
+
+	if(list_empty(&ds_iter->stack_head))
+		return NULL;
+
+	return list_last_entry(&ds_iter->stack_head, struct struct_stack_entry, l_entry)->def;
+}
+
+void ds_iter_destroy(struct ds_iter *ds_iter)
+{
+	struct struct_stack_entry *pos, *n;
+
+	if(list_empty(&ds_iter->stack_head))
+		return;
+
+	list_for_each_entry_safe(pos, n, &ds_iter->stack_head, l_entry) {
+		list_del(&pos->l_entry);
+		free(pos);
+	}
+}
+
+struct data_member *ds_iter_parent_member(struct ds_iter *ds_iter)
+{
+	struct struct_stack_entry *entry;
+
+	if(list_empty(&ds_iter->stack_head))
+		return NULL;
+
+	entry = list_last_entry(&ds_iter->stack_head, struct struct_stack_entry, l_entry);
+	return entry->parent_member;
+}
+
+int ds_iter_print_stack(struct ds_iter *ds_iter, char* stack, int stack_len)
+{
+	struct struct_stack_entry *pos;
+	struct data_member *cur_memb;
+	int depth = 0;
+	char indent[32] = {0};
+	char append[426] = {0};
+
+	memset(stack, 0, stack_len);
+
+	if(list_empty(&ds_iter->stack_head)) {
+		snprintf(stack, stack_len, "Empty data structure iterator stack");
+		return 0;
+	}
+
+	list_for_each_entry(pos, &ds_iter->stack_head, l_entry) {
+		if(depth >= sizeof(indent)) {
+			fprintf(stderr, "Data structure iterator: stack overflow!\n");
+			return -1;
+		}
+
+		/* End of the stack */
+		if(!pos->def && !pos->parent_member && pos->memb_idx == 0)
+			return 0;
+
+		indent[depth] = '\t';
+
+		/* Find the current member */
+		if(pos->def){
+			/* This is a definition, get the current member by index */
+			cur_memb = &pos->def->members[pos->memb_idx];
+			if(depth == 0)
+				snprintf(stack, stack_len, "struct %s", pos->def->name);
+		} else {
+			/*
+			 * This is not a definition, must be a base type. Thus parent_member is the
+			 * actual current member. This is a corner case where we called
+			 * ds_iter_init_member() with a member that has no definition.
+			 */
+			cur_memb = pos->parent_member;
+			if(depth == 0)
+				strncpy(stack, "struct <unknown>", stack_len);
+		}
+
+		snprintf(append, sizeof(append), "\n%s->(%s) %s",
+				indent, cur_memb->type_name, cur_memb->name);
+
+		if(strlen(stack) + strlen(append) >= stack_len) {
+			fprintf(stderr, "Data structure iterator: stack overflow!\n");
+			return -1;
+		}
+		strncat(stack, append, stack_len);
+		depth++;
+	}
+
+	return 0;
+}

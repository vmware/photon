+/*
+ * Drill down to absolute base type, check if at any point this type is a pointer.
+ * Safer than checks which rely on layer ordering, e.g typedef coming after pointer tag, etc.
+ */
+static bool tag_is_pointer(struct tag *tag, struct cu *cu)
+{
+	struct tag *prev = NULL;
+	while(prev != tag) {
+		prev = tag;
+		if(tag__is_modifier(tag) || tag__is_pointer(tag) || tag__is_array(tag, cu) || tag__is_class_member(tag)) {
+			if(tag__is_pointer(tag))
+				return true;
+			tag = cu__type(cu, tag->type);
+		} else if (tag__is_typedef(tag))
+			tag = tag__follow_typedef(tag, cu);
+
+		if(!tag)
+			return false;
+	}
+
+	return false;
+}

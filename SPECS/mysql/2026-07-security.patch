+  constexpr uint32 kDeclaredDataSize = 32;
+  constexpr uint64 kEncodedIntervalCount = UINT64_C(1) << 60;
+  constexpr size_t kMaterializedIntervals = 4 * 1000 * 1000;
+  constexpr size_t kBytesPerInterval = 2 * sizeof(uint64);

+
+  int8store(ptr, 1ULL);
+  ptr += 8;
+
+  memset(ptr, 0x11, 16);
+  ptr += 16;
+
+  int8store(ptr, kEncodedIntervalCount);
+  ptr += 8;
+
+  for (size_t i = 0; i < kMaterializedIntervals; i++) {
+    const ulonglong start = static_cast<ulonglong>(2 * i + 1);
+    const ulonglong end = start + 1;
+    int8store(ptr, start);
+    ptr += 8;
+    int8store(ptr, end);
+    ptr += 8;
+  }
+
+  return buffer;
+}

+    if (comp) {
+      switch (rec_get_status(rec)) {
+        case REC_STATUS_ORDINARY:
+          if (!page_is_leaf(page)) {
+            return DB_CORRUPTION;
+          }
+          break;
+        case REC_STATUS_NODE_PTR:
+          if (page_is_leaf(page)) {
+            return DB_CORRUPTION;
+          }
+          break;
+        case REC_STATUS_INFIMUM:
+        case REC_STATUS_SUPREMUM:
+        default:
+          return DB_CORRUPTION;
+      }
+    }
+
+    if (!rec_iter.next()) {
+      return DB_CORRUPTION;
+    }
+  }
+
+  if (n_recs != page_get_n_recs(page)) {
+    return DB_CORRUPTION;
+  }
+
+  return DB_SUCCESS;

+  EXPECT_TRUE(rec_try_get_next_offs(rec, true).has_value());
+
+  mach_write_to_2(rec - REC_NEXT, first_invalid_negative);
+  EXPECT_FALSE(rec_try_get_next_offs(rec, true).has_value());

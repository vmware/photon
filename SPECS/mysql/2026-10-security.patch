+    if (len == UNIV_SQL_NULL || len == UNIV_SQL_ADD_COL_DEFAULT ||
+        len == UNIV_SQL_INSTANT_DROP_COL) {
+      continue;
+    }
+
+    if (!is_span_within_page(field, len, page)) {
+      return DB_CORRUPTION;
+    }
+  }
+  return DB_SUCCESS;

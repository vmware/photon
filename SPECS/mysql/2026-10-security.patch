+++ b/mysql-test/suite/binlog_gtid/t/binlog_gtid_xa_prepare_recover_before_gtid_externalization_no_order.test
@@ -0,0 +1,70 @@
+# ==== Purpose ====
+#
+# Verify that XA PREPARE updates XA RECOVER before its GTID becomes visible
+# when binlog_order_commits is disabled.
+#
+# ==== Requirements ====
+#
+# R1. The test should exercise the GTID update path used when ordered binary
+#     log commits are disabled.
+# R2. While XA PREPARE is paused before GTID externalization, XA RECOVER
+#     should list the prepared XID.
+# R3. The XA PREPARE GTID should not be visible while paused, but should
+#     become visible after XA PREPARE completes.
+#
+# ==== References ====
+#
+# Bug#35872823: XA RECOVER may miss XID after XA PREPARE GTID is visible
+
+--source include/have_debug.inc
+--source include/have_debug_sync.inc
+--source include/have_binlog_format_row.inc
+
+RESET MASTER;
+--let $assert_text = binlog_order_commits is disabled
+--let $binlog_order_commits = `SELECT @@GLOBAL.binlog_order_commits`
+--let $assert_cond = "$binlog_order_commits" = "0"
+--source include/assert.inc
+
+CREATE TABLE t1 (a INT);
+
+--connect(con1,localhost,root,,)
+--connection con1
+SET @@SESSION.xa_detach_on_prepare = ON;
+--let $prepare_gtid = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1
+--eval SET GTID_NEXT = '$prepare_gtid'
+XA START 'xa_prepare_no_order';
+INSERT INTO t1 VALUES (1);
+XA END 'xa_prepare_no_order';
+
+--connection default
+--let $auxiliary_connection = default
+--let $statement_connection = con1
+--let $statement = XA PREPARE 'xa_prepare_no_order'
+--let $sync_point = after_call_actions_before_gtid_state_update
+--source include/execute_to_conditional_timestamp_sync_point.inc
+
+--let $expected_prepared_xa_count = 1
+--source extra/xa_crash_safe_tests/assert_xa_recover.inc
+--let $assert_text = GTID_EXECUTED does not contain the XA PREPARE GTID yet
+--let $has_gtid = `SELECT GTID_SUBSET('$prepare_gtid', @@GLOBAL.gtid_executed)`
+--let $assert_cond = "$has_gtid" = "0"
+--source include/assert.inc
+
+--let $reap_statement_connection = 1
+--source include/execute_from_conditional_timestamp_sync_point.inc
+--let $reap_statement_connection = 0
+--let $assert_text = GTID_EXECUTED contains the XA PREPARE GTID
+--let $has_gtid = `SELECT GTID_SUBSET('$prepare_gtid', @@GLOBAL.gtid_executed)`
+--let $assert_cond = "$has_gtid" = "1"
+--source include/assert.inc
+
+--connection con1
+SET GTID_NEXT = AUTOMATIC;
+--connection default
+XA ROLLBACK 'xa_prepare_no_order';
+
+--disconnect con1
+--connection default
+DROP TABLE t1;
+RESET MASTER;
--- /dev/null
+++ b/mysql-test/suite/binlog_gtid/t/binlog_gtid_xa_prepare_recover_before_gtid_externalization.test
@@ -0,0 +1,97 @@
+# ==== Purpose ====
+#

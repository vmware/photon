+static size_t my_strmov_quoted_user_var_name(char *buffer,
+                                             const char *identifier,
+                                             size_t length) {
+  char *pos = buffer;
+
+  *pos++ = '\'';
+  for (size_t i = 0; i < length; i++) {
+    switch (identifier[i]) {
+      case '\0':
+        *pos++ = '\\';
+        *pos++ = '0';
+        break;
+      case '\'':
+        *pos++ = '\\';
+        *pos++ = '\'';
+        break;
+      case '\\':
+        *pos++ = '\\';
+        *pos++ = '\\';
+        break;
+      case '\n':
+        *pos++ = '\\';
+        *pos++ = 'n';
+        break;
+      case '\r':
+        *pos++ = '\\';
+        *pos++ = 'r';
+        break;
+      case '\t':
+        *pos++ = '\\';
+        *pos++ = 't';
+        break;
+      case '\b':
+        *pos++ = '\\';
+        *pos++ = 'b';
+        break;
+      case '\032':
+        *pos++ = '\\';
+        *pos++ = 'Z';
+        break;
+      default:
+        *pos++ = identifier[i];
+        break;
+    }
+  }
+  *pos++ = '\'';
+  return pos - buffer;
+}

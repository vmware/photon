{
  "photon-build-param": {
    "photon-build-type": "chroot",
    "photon-dist-tag": ".ph5",
    "photon-release-version": "5.0",
    "photon-release-version-to-consume": "5.0",
    "threads": 4,
    "ossl-fips-in-make-check": true,
    "loglevel": "info",
    "full-package-list-file": "build_install_options_all.json",
    "pkg-build-options": "pkg_build_options.json",
    "photon-docker-image": "photon:5.0",

    "package-repo-url": "https://packages.broadcom.com/photon/$releasever/photon_$releasever_$basearch",

    "package-repo-snapshot-file-url": "https://packages.broadcom.com/photon/$releasever/photon_snapshots_$releasever_$basearch/SUBRELEASE/snapshot-SUBRELEASE-latest.$basearch.list",

    "photon-docker-image-urls": {
        "x86_64": "https://github.com/vmware/photon-docker-image/raw/x86_64/5.0-20260116/docker/photon-rootfs-5.0-7b75b7b27.x86_64.tar.gz",
        "aarch64": "https://github.com/vmware/photon-docker-image/raw/aarch64/5.0-20260116/docker/photon-rootfs-5.0-bebba07d3.aarch64.tar.gz"
    },

    "build-src-rpm": true,
    "build-dbginfo-rpm": true,
    "build-dbginfo-rpm-list": [
      "glibc",
      "linux",
      "linux-esx"
    ],
    "extra-packages-list": [
      "chromium"
    ],
    "target": "iso",
    "compression-macro": "w19.zstdio",
    "pull-sources-config": "https://packages.broadcom.com/photon/photon_sources/1.0",
    "copy-to-sandbox": {
      "adjust-gcc-specs": {
        "src": "support/package-builder/adjust-gcc-specs.sh",
        "dest": "/root/adjust-gcc-specs.sh"
      },
      "print-java-home": {
        "src": "tools/scripts/print-java-home.java",
        "dest": "/root/print-java-home.java"
      }
    }
  },
  "photon-branch": "common",
  "photon-path": "",
  "stage-path": "./stage",
  "spec-path": "",
  "release-branch-path": ""
}
